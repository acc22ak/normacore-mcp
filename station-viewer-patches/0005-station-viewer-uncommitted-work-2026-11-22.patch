@@ -0,0 +1,20 @@
+import type { FrameEntry } from '@/api/frame-parser';
+import { usbvideo } from '@/api/proto.js';
+
+/**
+ * Station keeps a queue for every camera it has ever seen, and each stays in the live frame after
+ * the camera is unplugged. The last thing Station writes to an unplugged camera's queue is a
+ * "recording ended" or "disconnected" event, so a queue whose newest entry is one of those is a
+ * camera that is gone, not one that is about to send video.
+ */
+export function isCameraConnected(source: FrameEntry<usbvideo.IRxEnvelope>): boolean {
+  const type = source.data?.type;
+  return type !== usbvideo.RxEnvelopeType.ET_DEVICE_DISCONNECTED
+    && type !== usbvideo.RxEnvelopeType.ET_DEVICE_RECORDING_END;
+}
+
+export function connectedCameras(
+  sources: FrameEntry<usbvideo.IRxEnvelope>[] | undefined,
+): FrameEntry<usbvideo.IRxEnvelope>[] {
+  return (sources ?? []).filter(isCameraConnected);
+}
