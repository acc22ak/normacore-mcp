+import * as THREE from 'three';
+
+/**
+ * Position-only inverse kinematics for a URDF arm loaded by urdf-loader.
+ *
+ * Works in the renderer's normalized joint space (0..1 inside each joint's URDF
+ * limits, the same mapping the 3D view uses to draw the live arm), so a solution
+ * can be sent to the servos with the same normalized → raw conversion as the
+ * web-control sliders. Damped least squares with a numeric Jacobian: the ElRobot
+ * has 7 arm joints for a 3-D target, so it is redundant and has no closed form.
+ */
+
+export interface IkJoint {
+  name: string;
+  lower: number;
+  upper: number;
+  /** Per-arm alignment offset (rad) added after mapping, same as the live 3D view. */
+  offset?: number;
+}
+
+export interface IkChain {
+  robot: THREE.Object3D & { joints: Record<string, { setJointValue: (v: number) => void }> };
+  joints: IkJoint[];
+  /** Link whose subtree is the gripper. */
+  endLink: THREE.Object3D;
+  /** Gripper reference point, in endLink's local frame. */
+  tipLocal: THREE.Vector3;
+}
+
+export interface IkResult {
+  positions: number[];
+  error: number;
+  reached: boolean;
+}
+
+const MARGIN = 0.01; // stay a little inside the calibrated range
+const EPS = 1e-3;
+const DAMPING = 0.02;
+const MAX_STEP = 0.04;
+const MAX_ITERATIONS = 80;
+const TOLERANCE_M = 0.002;
+
+export function applyJointPositions(chain: IkChain, positions: number[]): void {
+  chain.joints.forEach((joint, i) => {
+    const p = positions[i];
+    chain.robot.joints[joint.name]?.setJointValue(joint.lower + p * (joint.upper - joint.lower) + (joint.offset ?? 0));
+  });
+  chain.robot.updateMatrixWorld(true);
+}
+
+export function tipWorldPosition(chain: IkChain, out = new THREE.Vector3()): THREE.Vector3 {
+  return chain.endLink.localToWorld(out.copy(chain.tipLocal));
+}
+
+/** Centre of the gripper geometry, expressed in endLink's frame. Null until meshes load. */
+export function measureTipLocal(endLink: THREE.Object3D): THREE.Vector3 | null {
+  endLink.updateMatrixWorld(true);
+  const box = new THREE.Box3().setFromObject(endLink, true);
+  if (box.isEmpty()) return null;
+  return endLink.worldToLocal(box.getCenter(new THREE.Vector3()));
+}
+
+function solve3x3(m: number[], b: THREE.Vector3): THREE.Vector3 | null {
+  const [a, bb, c, d, e, f, g, h, i] = m;
+  const det = a * (e * i - f * h) - bb * (d * i - f * g) + c * (d * h - e * g);
+  if (Math.abs(det) < 1e-12) return null;
+  const inv = [
+    (e * i - f * h), -(bb * i - c * h), (bb * f - c * e),
+    -(d * i - f * g), (a * i - c * g), -(a * f - c * d),
+    (d * h - e * g), -(a * h - bb * g), (a * e - bb * d),
+  ].map((v) => v / det);
+  return new THREE.Vector3(
+    inv[0] * b.x + inv[1] * b.y + inv[2] * b.z,
+    inv[3] * b.x + inv[4] * b.y + inv[5] * b.z,
+    inv[6] * b.x + inv[7] * b.y + inv[8] * b.z,
+  );
+}
+
+export function solvePositionIk(chain: IkChain, start: number[], target: THREE.Vector3): IkResult {
+  const n = chain.joints.length;
+  const lo = MARGIN;
+  const hi = 1 - MARGIN;
+  const p = start.map((v) => THREE.MathUtils.clamp(v, lo, hi));
+  const tip = new THREE.Vector3();
+  const probe = new THREE.Vector3();
+  const err = new THREE.Vector3();
+  const jac: THREE.Vector3[] = Array.from({ length: n }, () => new THREE.Vector3());
+
+  const errorAt = (q: number[]) => {
+    applyJointPositions(chain, q);
+    return tipWorldPosition(chain, probe).distanceTo(target);
+  };
+
+  applyJointPositions(chain, p);
+  let error = tipWorldPosition(chain, tip).distanceTo(target);
+  let damping = DAMPING;
+
+  for (let iter = 0; iter < MAX_ITERATIONS && error > TOLERANCE_M; iter++) {
+    applyJointPositions(chain, p);
+    tipWorldPosition(chain, tip);
+    err.subVectors(target, tip);
+
+    for (let j = 0; j < n; j++) {
+      const saved = p[j];
+      // Probe away from the nearest limit so pinned joints still get a slope.
+      const h = saved + EPS <= hi ? EPS : -EPS;
+      p[j] = saved + h;
+      applyJointPositions(chain, p);
+      tipWorldPosition(chain, probe);
+      jac[j].subVectors(probe, tip).divideScalar(h);
+      p[j] = saved;
+    }
+
+    // Active set: a joint at a limit whose gradient pushes it further out is frozen.
+    const active = jac.map((col, j) => {
+      const g = col.dot(err);
+      return !((p[j] <= lo + 1e-6 && g < 0) || (p[j] >= hi - 1e-6 && g > 0));
+    });
+
+    // (J Jᵀ + λ² I) y = e over active joints,  Δp = Jᵀ y
+    const m = [0, 0, 0, 0, 0, 0, 0, 0, 0];
+    jac.forEach((col, j) => {
+      if (!active[j]) return;
+      const c = [col.x, col.y, col.z];
+      for (let r = 0; r < 3; r++) for (let k = 0; k < 3; k++) m[r * 3 + k] += c[r] * c[k];
+    });
+    m[0] += damping * damping;
+    m[4] += damping * damping;
+    m[8] += damping * damping;
+    const y = solve3x3(m, err);
+    if (!y) break;
+
+    const dp = jac.map((col, j) => (active[j] ? col.dot(y) : 0));
+    const stepNorm = Math.max(...dp.map(Math.abs));
+    let scale = stepNorm > MAX_STEP ? MAX_STEP / stepNorm : 1;
+
+    // Backtracking: only accept steps that bring the gripper closer.
+    let accepted = false;
+    for (let tries = 0; tries < 6; tries++) {
+      const candidate = p.map((v, j) => THREE.MathUtils.clamp(v + dp[j] * scale, lo, hi));
+      const candidateError = errorAt(candidate);
+      if (candidateError < error) {
+        for (let j = 0; j < n; j++) p[j] = candidate[j];
+        error = candidateError;
+        accepted = true;
+        damping = Math.max(DAMPING * 0.5, damping * 0.7);
+        break;
+      }
+      scale *= 0.5;
+    }
+    if (!accepted) {
+      damping *= 3;
+      if (damping > 1) break;
+    }
+  }
+
+  applyJointPositions(chain, p);
+  error = tipWorldPosition(chain, tip).distanceTo(target);
+  return { positions: p, error, reached: error < 0.01 };
+}
