--- /dev/null
+++ b/software/station/clients/station-viewer/src/realsense/calibration-store.ts
@@ -0,0 +1,304 @@
+import { useSyncExternalStore } from 'react';
+import * as THREE from 'three';
+import { applyPoseToObject, deprojectToLocal, getCameraPose, poseFromRigid, setCameraPose, type CameraPose } from './camera-pose';
+import { sampleDepthMm, type RealsenseFrame } from './protocol';
+import { getLatestRealsenseFrame } from './realsense-store';
+import { fitRigid, fitYawAndPosition } from './rigid-fit';
+import { fitDominantPlane, levelPose, tableCandidatePoints } from './table-plane';
+import { armCandidatePoints, armShapeError, fitArmShape, type ArmSample } from './arm-icp';
+
+// Click calibration: pairs "gripper tip clicked in the camera image" (camera frame, from depth)
+// with "gripper tip in the 3D view" (world frame, from joint angles), then solves the camera pose.
+// The 3D view with the point cloud registers a tip provider while it's mounted.
+
+export interface CalibrationPair {
+  id: number;
+  camera: THREE.Vector3;
+  world: THREE.Vector3;
+  /** Pixel on the depth grid, for drawing the marker on the feed. */
+  u: number;
+  v: number;
+}
+
+export interface CalibrationSolution {
+  pose: CameraPose;
+  errors: number[];
+  rms: number;
+}
+
+export interface CalibrationState {
+  active: boolean;
+  pairs: CalibrationPair[];
+  solution: CalibrationSolution | null;
+  message: string;
+  hasTipProvider: boolean;
+  /** Keep pitch, roll and height (from "Level to table") and solve only yaw + side/distance. */
+  keepLevel: boolean;
+  /** Result of the last "Level to table" / arm fit, for display. */
+  levelInfo: string;
+  /** Arm poses recorded for the multi-pose arm-shape fit. */
+  armSampleCount: number;
+}
+
+export const MIN_CALIBRATION_PAIRS = 4;
+export const MIN_LEVEL_CALIBRATION_PAIRS = 3;
+
+/**
+ * The clicked pixel's depth is the gripper's surface facing the camera, while the 3D tip is the
+ * centre of the gripper's bounding box. Push clicked points this far further along the camera ray.
+ */
+const SURFACE_TO_CENTER_M = 0.015;
+
+type TipProvider = () => THREE.Vector3 | null;
+type SurfaceProvider = (maxPoints: number) => THREE.Vector3[];
+
+let tipProvider: TipProvider | null = null;
+let surfaceProvider: SurfaceProvider | null = null;
+type IkProvider = (target: THREE.Vector3) => { positions: number[]; error: number } | null;
+let ikProvider: IkProvider | null = null;
+let nextId = 1;
+let state: CalibrationState = {
+  active: false,
+  pairs: [],
+  solution: null,
+  message: '',
+  hasTipProvider: false,
+  keepLevel: false,
+  levelInfo: '',
+  armSampleCount: 0,
+};
+let armSamples: ArmSample[] = [];
+const listeners = new Set<() => void>();
+
+function update(patch: Partial<CalibrationState>) {
+  state = { ...state, ...patch };
+  listeners.forEach((l) => l());
+}
+
+function solve(pairs: CalibrationPair[]): Pick<CalibrationState, 'solution' | 'message'> {
+  const needed = state.keepLevel ? MIN_LEVEL_CALIBRATION_PAIRS : MIN_CALIBRATION_PAIRS;
+  if (pairs.length < needed) {
+    return { solution: null, message: `${pairs.length}/${needed} points. Move the arm and click the gripper tip again.` };
+  }
+  try {
+    if (state.keepLevel) {
+      const level = getCameraPose();
+      const fit = fitYawAndPosition(pairs.map((p) => p.camera), pairs.map((p) => p.world), level.pitch, level.roll, level.y);
+      return {
+        solution: {
+          pose: { ...level, yaw: fit.yaw, x: fit.translation.x, z: fit.translation.z },
+          errors: fit.errors,
+          rms: fit.rms,
+        },
+        message: `Fit error ${(fit.rms * 100).toFixed(1)} cm RMS (level kept). Add more points or apply.`,
+      };
+    }
+    const fit = fitRigid(pairs.map((p) => p.camera), pairs.map((p) => p.world));
+    return {
+      solution: { pose: poseFromRigid(fit.rotation, fit.translation), errors: fit.errors, rms: fit.rms },
+      message: `Fit error ${(fit.rms * 100).toFixed(1)} cm RMS. Add more points or apply.`,
+    };
+  } catch (err) {
+    return { solution: null, message: err instanceof Error ? err.message : 'Could not solve' };
+  }
+}
+
+export function registerTipProvider(provider: TipProvider): () => void {
+  tipProvider = provider;
+  update({ hasTipProvider: true });
+  return () => {
+    if (tipProvider === provider) {
+      tipProvider = null;
+      update({ hasTipProvider: false });
+    }
+  };
+}
+
+/** Current tip position in the 3D view (world frame), or null if no 3D view provides it. */
+export function getTipWorldPosition(): THREE.Vector3 | null {
+  return tipProvider?.() ?? null;
+}
+
+export function startCalibration(): void {
+  update({
+    active: true,
+    pairs: [],
+    solution: null,
+    message: 'Move the arm, keep it still, then click the gripper tip in the image.',
+  });
+}
+
+export function cancelCalibration(): void {
+  update({ active: false, pairs: [], solution: null, message: '' });
+}
+
+export function addCalibrationPick(frame: RealsenseFrame, u: number, v: number): void {
+  if (!state.active) return;
+  const tip = tipProvider?.();
+  if (!tip) {
+    update({ message: 'Turn on depth points in the arm\'s 3D view first.' });
+    return;
+  }
+  const depthMm = sampleDepthMm(frame, u, v);
+  if (depthMm === null) {
+    update({ message: 'No depth at that spot. Click again on the gripper.' });
+    return;
+  }
+  const camera = deprojectToLocal(u, v, depthMm / 1000, frame.header.intrinsics);
+  camera.multiplyScalar(1 + SURFACE_TO_CENTER_M / camera.length());
+  const pairs = [...state.pairs, { id: nextId++, camera, world: tip.clone(), u, v }];
+  update({ pairs, ...solve(pairs) });
+}
+
+export function registerIkProvider(provider: IkProvider): () => void {
+  ikProvider = provider;
+  return () => {
+    if (ikProvider === provider) ikProvider = null;
+  };
+}
+
+/** World point (robot frame) under a feed pixel, given as fractions 0..1 of the image size. */
+export function pixelToWorld(fx: number, fy: number, radius = 2): THREE.Vector3 | null {
+  const frame = getLatestRealsenseFrame();
+  if (!frame) return null;
+  const { w, h } = frame.header.depth;
+  const u = fx * w;
+  const v = fy * h;
+  const mm = sampleDepthMm(frame, u, v, radius);
+  if (mm === null) return null;
+  const rig = new THREE.Object3D();
+  applyPoseToObject(getCameraPose(), rig);
+  rig.updateMatrix();
+  return deprojectToLocal(u, v, mm / 1000, frame.header.intrinsics).applyMatrix4(rig.matrix);
+}
+
+// Dev-only console/automation hooks: lets an operator (or Claude through the browser) turn
+// camera pixels into robot-frame points and ask the 3D view for IK.
+if (import.meta.env.DEV && typeof window !== 'undefined') {
+  (window as unknown as Record<string, unknown>).__realsense = {
+    pixelToWorld: (fx: number, fy: number, r?: number) => pixelToWorld(fx, fy, r)?.toArray() ?? null,
+    tip: () => tipProvider?.()?.toArray() ?? null,
+    pose: () => getCameraPose(),
+    solveIk: (x: number, y: number, z: number) => ikProvider?.(new THREE.Vector3(x, y, z)) ?? null,
+  };
+}
+
+export function registerSurfaceProvider(provider: SurfaceProvider): () => void {
+  surfaceProvider = provider;
+  return () => {
+    if (surfaceProvider === provider) surfaceProvider = null;
+  };
+}
+
+function captureArmSample(frame: RealsenseFrame | null): ArmSample | null {
+  if (!frame) {
+    update({ levelInfo: 'No camera frame yet.' });
+    return null;
+  }
+  const modelPoints = surfaceProvider?.(6000) ?? [];
+  if (modelPoints.length === 0) {
+    update({ levelInfo: 'Turn on depth points in the arm\'s 3D view first.' });
+    return null;
+  }
+  const cameraPoints = armCandidatePoints(frame, getCameraPose(), modelPoints);
+  return { cameraPoints, modelPoints };
+}
+
+/** Record the current arm pose (depth points + 3D arm surface) for the multi-pose fit. */
+export function addArmSample(frame: RealsenseFrame | null): void {
+  const sample = captureArmSample(frame);
+  if (!sample) return;
+  armSamples = [...armSamples, sample];
+  const err = armShapeError([sample], getCameraPose());
+  update({
+    armSampleCount: armSamples.length,
+    levelInfo: `Pose ${armSamples.length} recorded: ${sample.cameraPoints.length} arm points, currently ${(err.rms * 1000).toFixed(1)} mm off.`,
+  });
+}
+
+export function clearArmSamples(): void {
+  armSamples = [];
+  update({ armSampleCount: 0, levelInfo: '' });
+}
+
+/** How far the arm's depth points are from the 3D arm right now (no fitting). */
+export function checkArmFit(frame: RealsenseFrame | null): void {
+  const sample = captureArmSample(frame);
+  if (!sample) return;
+  const err = armShapeError([sample], getCameraPose());
+  update({ levelInfo: `Current pose: ${err.matched} arm points, ${(err.rms * 1000).toFixed(1)} mm RMS from the 3D arm.` });
+}
+
+/**
+ * Refine yaw + side/distance by fitting the depth points of the real arm onto the 3D arm's
+ * surface (ICP) over every recorded pose (or the current one if none are recorded). Keeps pitch,
+ * roll and height, so run "Level to table" first.
+ */
+export function fitToArmShape(frame: RealsenseFrame | null): void {
+  let samples = armSamples;
+  if (samples.length === 0) {
+    const sample = captureArmSample(frame);
+    if (!sample) return;
+    samples = [sample];
+  }
+  const start = getCameraPose();
+  try {
+    const result = fitArmShape(samples, start);
+    setCameraPose(result.pose);
+    const moved = Math.hypot(result.pose.x - start.x, result.pose.z - start.z);
+    update({
+      levelInfo: `Arm fit over ${samples.length} pose(s): ${result.matched} points within ${(result.rms * 1000).toFixed(1)} mm RMS. Moved ${(moved * 100).toFixed(1)} cm, yaw ${((result.pose.yaw - start.yaw) * 180 / Math.PI).toFixed(1)}°.`,
+    });
+  } catch (err) {
+    update({ levelInfo: err instanceof Error ? err.message : 'Arm fit failed' });
+  }
+}
+
+export function setKeepLevel(keepLevel: boolean): void {
+  update({ keepLevel });
+  update(solve(state.pairs));
+}
+
+/** Fit the table plane in `frame` and set the camera's pitch, roll and height from it. */
+export function levelToTable(frame: RealsenseFrame | null): void {
+  if (!frame) {
+    update({ levelInfo: 'No camera frame yet.' });
+    return;
+  }
+  try {
+    const plane = fitDominantPlane(tableCandidatePoints(frame));
+    setCameraPose(levelPose(getCameraPose(), plane));
+    update({
+      keepLevel: true,
+      levelInfo: `Table found: ${plane.inliers} points, flat to ${(plane.rms * 1000).toFixed(1)} mm. Camera ${(plane.distance * 100).toFixed(1)} cm above it.`,
+    });
+  } catch (err) {
+    update({ levelInfo: err instanceof Error ? err.message : 'Could not find the table' });
+  }
+}
+
+export function removeCalibrationPair(id: number): void {
+  const pairs = state.pairs.filter((p) => p.id !== id);
+  update({ pairs, ...solve(pairs) });
+}
+
+export function applyCalibration(): void {
+  if (!state.solution) return;
+  setCameraPose(state.solution.pose);
+  update({ active: false, pairs: [], solution: null, message: '' });
+}
+
+function subscribe(listener: () => void): () => void {
+  listeners.add(listener);
+  return () => {
+    listeners.delete(listener);
+  };
+}
+
+export function getCalibrationState(): CalibrationState {
+  return state;
+}
+
+export function useCalibrationState(): CalibrationState {
+  return useSyncExternalStore(subscribe, getCalibrationState, getCalibrationState);
+}
