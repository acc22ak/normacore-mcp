@@ -0,0 +1,91 @@
+// Wire format of realsense-bridge (robotic-hackathon/realsense-bridge/bridge.py).
+// Binary: uint32 LE headerLen | JSON header | JPEG color | depth uint16 LE (mm, row-major).
+// Text: JSON status messages.
+
+export interface RealsenseIntrinsics {
+  fx: number;
+  fy: number;
+  ppx: number;
+  ppy: number;
+}
+
+export interface RealsenseFrameHeader {
+  type: 'frame';
+  seq: number;
+  ts: number;
+  color: { w: number; h: number; bytes: number };
+  depth: { w: number; h: number; bytes: number; unit_m: number };
+  intrinsics: RealsenseIntrinsics;
+  serial: string;
+}
+
+export interface RealsenseFrame {
+  header: RealsenseFrameHeader;
+  /** JPEG bytes of the color image (color.w × color.h). */
+  jpeg: Uint8Array;
+  /** Depth in millimetres on a depth.w × depth.h grid aligned to the color image; 0 = no data. */
+  depth: Uint16Array;
+}
+
+export type RealsenseState = 'streaming' | 'no_device' | 'error';
+
+export interface RealsenseStatusMessage {
+  type: 'status';
+  state: RealsenseState;
+  message?: string;
+  serial?: string;
+  firmware?: string;
+  name?: string;
+}
+
+export function parseFrameMessage(buffer: ArrayBuffer): RealsenseFrame {
+  if (buffer.byteLength < 4) throw new Error('RealSense message too short');
+  const view = new DataView(buffer);
+  const headerLen = view.getUint32(0, true);
+  const headerEnd = 4 + headerLen;
+  if (headerEnd > buffer.byteLength) throw new Error('RealSense header truncated');
+
+  const header = JSON.parse(
+    new TextDecoder().decode(new Uint8Array(buffer, 4, headerLen)),
+  ) as RealsenseFrameHeader;
+  if (header.type !== 'frame') throw new Error(`Unexpected RealSense message type ${String(header.type)}`);
+
+  const jpegEnd = headerEnd + header.color.bytes;
+  const depthEnd = jpegEnd + header.depth.bytes;
+  if (depthEnd > buffer.byteLength) throw new Error('RealSense frame truncated');
+  if (header.depth.bytes !== header.depth.w * header.depth.h * 2) {
+    throw new Error('RealSense depth size does not match its dimensions');
+  }
+
+  const jpeg = new Uint8Array(buffer, headerEnd, header.color.bytes);
+  // Copy: the depth offset is not guaranteed to be 2-byte aligned. Data is little-endian,
+  // which matches every browser platform we run on.
+  const depth = new Uint16Array(buffer.slice(jpegEnd, depthEnd));
+  return { header, jpeg, depth };
+}
+
+export function parseStatusMessage(text: string): RealsenseStatusMessage | null {
+  try {
+    const msg = JSON.parse(text);
+    return msg && msg.type === 'status' ? (msg as RealsenseStatusMessage) : null;
+  } catch {
+    return null;
+  }
+}
+
+/** Median of the valid (non-zero) depth values in a (2r+1)² window, in millimetres; null if none. */
+export function sampleDepthMm(frame: RealsenseFrame, u: number, v: number, radius = 2): number | null {
+  const { w, h } = frame.header.depth;
+  const values: number[] = [];
+  const cu = Math.round(u);
+  const cv = Math.round(v);
+  for (let y = Math.max(0, cv - radius); y <= Math.min(h - 1, cv + radius); y++) {
+    for (let x = Math.max(0, cu - radius); x <= Math.min(w - 1, cu + radius); x++) {
+      const d = frame.depth[y * w + x];
+      if (d > 0) values.push(d);
+    }
+  }
+  if (values.length === 0) return null;
+  values.sort((a, b) => a - b);
+  return values[values.length >> 1];
+}
diff --git a/software/station/clients/station-viewer/src/realsense/realsense-store.ts b/software/station/clients/station-viewer/src/realsense/realsense-store.ts
