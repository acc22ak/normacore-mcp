+import { useState } from 'react';
+import RealsenseFeed, { type RealsenseFeedMode } from './RealsenseFeed';
+import { useRealsenseStatus } from './realsense-store';
+
+export function RealsenseModeToggle({ mode, onChange }: { mode: RealsenseFeedMode; onChange: (m: RealsenseFeedMode) => void }) {
+  return (
+    <div className="flex" role="group" aria-label="RealSense image">
+      {(['color', 'depth'] as const).map((m) => (
+        <button
+          key={m}
+          type="button"
+          onClick={() => onChange(m)}
+          className={`h-7 rounded-md px-2 text-[12px] font-medium capitalize transition-colors ${mode === m ? 'bg-surface-elevated text-text-primary' : 'text-text-muted hover:text-text-primary'}`}
+          aria-pressed={mode === m}
+        >
+          {m}
+        </button>
+      ))}
+    </div>
+  );
+}
+
+/** RealSense camera card for the live page. Renders nothing while the bridge isn't running. */
+function RealsenseSurface() {
+  const status = useRealsenseStatus();
+  const [mode, setMode] = useState<RealsenseFeedMode>('color');
+
+  if (!status.connected) return null;
+
+  return (
+    <section className="w-full overflow-hidden rounded-lg border border-border-default bg-surface-secondary">
+      <header className="flex items-center gap-3 border-b border-border-default px-4 py-2">
+        <h2 className="text-[13px] font-medium text-text-primary">{status.name ?? 'RealSense'}</h2>
+        {status.serial && <span className="font-mono text-[11px] text-text-muted">#{status.serial}</span>}
+        {!status.streaming && (
+          <span className="text-[12px] text-accent-warning">{status.message || 'Waiting for camera'}</span>
+        )}
+        <div className="ml-auto">
+          <RealsenseModeToggle mode={mode} onChange={setMode} />
+        </div>
+      </header>
+      {status.streaming && <RealsenseFeed mode={mode} className="aspect-[4/3] max-h-[70vh] w-full" />}
+    </section>
+  );
+}
+
+export default RealsenseSurface;
