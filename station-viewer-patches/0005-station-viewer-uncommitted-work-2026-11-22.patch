+import { describe, expect, it } from 'vitest';
+import { mapJointAngle } from './joint-alignment';
+
+// The Python side (normacore-mcp/arm_model.py joint_values) uses the same formula. If the two drift
+// apart, the depth points are drawn against a differently-posed arm and pick/place miss by centimetres.
+describe('mapJointAngle', () => {
+  const lower = -1.612;
+  const upper = 1.612;
+
+  it('without a span stretches 0..1 over the URDF limits', () => {
+    expect(mapJointAngle(0, lower, upper)).toBeCloseTo(lower);
+    expect(mapJointAngle(0.9, lower, upper, undefined, 0.1)).toBeCloseTo(lower + 0.9 * (upper - lower) + 0.1);
+  });
+
+  it('with a true span keeps the middle and scales away from it', () => {
+    const span = 3.3778; // shoulder: 193.5 deg
+    expect(mapJointAngle(0.5, lower, upper, span)).toBeCloseTo(0);
+    expect(mapJointAngle(0.9, lower, upper, span, 0.0637)).toBeCloseTo(0.4 * span + 0.0637);
+    // 2-5% more rotation than the URDF mapping at the same position
+    expect(mapJointAngle(0.9, lower, upper, span) / mapJointAngle(0.9, lower, upper)).toBeGreaterThan(1.02);
+  });
+});
