@@ -0,0 +1,29 @@
+import { useEffect, useMemo } from 'react';
+import { useSearchParams } from 'react-router-dom';
+import webSocketManager from '@/api/websocket';
+import { useFrameData } from '@/hooks';
+import LiveDeviceSurface from '@/devices/LiveDeviceSurface';
+import { resolveLiveDevices } from '@/devices/live-registry';
+
+// Dev-only: renders a recorded frame through the Live layout, so device UI can be
+// designed without hardware. /preview?frame=10000
+function LivePreviewPage() {
+  const [params] = useSearchParams();
+  const frameNumber = Number(params.get('frame') ?? '0');
+  useEffect(() => webSocketManager.acquireHistoryMode(), []);
+  const { parsedFrame, isLoading, error } = useFrameData({ frameNumber, immediate: true });
+  const plan = useMemo(() => resolveLiveDevices(parsedFrame), [parsedFrame]);
+
+  return (
+    <div className="flex flex-1 flex-col gap-5 p-5">
+      <p className="pointer-events-none fixed bottom-3 right-4 z-40 rounded-md bg-surface-base/80 px-2 py-1 text-[12px] text-text-muted">
+        Preview of recorded frame <span className="font-mono">{frameNumber.toLocaleString()}</span> in the Live layout.
+        {isLoading && ' Reading…'}
+        {error && <span className="text-accent-critical"> {error}</span>}
+      </p>
+      {!plan.isEmpty && <LiveDeviceSurface plan={plan} />}
+    </div>
+  );
+}
+
+export default LivePreviewPage;
