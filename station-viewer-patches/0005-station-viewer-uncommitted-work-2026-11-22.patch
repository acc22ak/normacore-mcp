+++ b/software/station/clients/station-viewer/src/st3215/robot-rendering/camera-tour.ts
@@ -0,0 +1,157 @@
+import * as THREE from 'three';
+import type { RobotSceneAddon } from './types';
+
+// Auto camera for demos: while the arm works, the 3D view glides slowly to the next of a few good
+// viewpoints, then holds still. It never moves while the arm is idle, never jumps (every move eases in
+// and out from wherever the camera is), and steps aside for the user: any drag or zoom pauses it.
+
+interface View {
+  /** Around +Y, from the robot's forward axis (+X) toward its right (+Z), degrees. */
+  azimuthDeg: number;
+  /** Above the table, degrees. */
+  elevationDeg: number;
+  distanceM: number;
+}
+
+/** Where the camera looks: over the middle of the arm's workspace (world frame, metres). */
+const TARGET = new THREE.Vector3(0.16, 0.06, 0);
+const VIEWS: View[] = [
+  { azimuthDeg: 35, elevationDeg: 30, distanceM: 0.75 }, // front-right of the arm, from the camera side
+  { azimuthDeg: 95, elevationDeg: 22, distanceM: 0.7 }, // its right side
+  { azimuthDeg: 55, elevationDeg: 55, distanceM: 0.8 }, // high, looking down on the table
+  { azimuthDeg: -40, elevationDeg: 28, distanceM: 0.75 }, // front-left
+  { azimuthDeg: -95, elevationDeg: 22, distanceM: 0.7 }, // its left side
+];
+/**
+ * Framing: the arm is drawn left of centre and a little low, because the camera feeds take the top-right
+ * corner of the view. Screen-space shift of the look-at point, as a fraction of the camera distance.
+ */
+const FRAME_SHIFT_RIGHT = 0.22;
+const FRAME_SHIFT_UP = 0.08;
+const MOVE_MS = 5000;
+/** At least this long at each viewpoint before the next move. */
+const HOLD_MS = 8000;
+/** The arm counts as working while its tip moved within this window. */
+const ACTIVE_WINDOW_MS = 1500;
+const TIP_MOVE_M = 0.003;
+/** A drag or zoom by the user pauses the tour this long. */
+const USER_PAUSE_MS = 30000;
+
+interface Spherical {
+  az: number;
+  el: number;
+  dist: number;
+}
+
+function toSpherical(position: THREE.Vector3, target: THREE.Vector3): Spherical {
+  const d = position.clone().sub(target);
+  const dist = d.length();
+  return { az: Math.atan2(d.z, d.x), el: Math.asin(THREE.MathUtils.clamp(d.y / dist, -1, 1)), dist };
+}
+
+function fromView(view: View): Spherical {
+  return {
+    az: THREE.MathUtils.degToRad(view.azimuthDeg),
+    el: THREE.MathUtils.degToRad(view.elevationDeg),
+    dist: view.distanceM,
+  };
+}
+
+/** Puts the camera at `s` around `target`, framed per FRAME_SHIFT_*; returns the point it looks at. */
+function place(camera: THREE.Camera, target: THREE.Vector3, s: Spherical): THREE.Vector3 {
+  const c = Math.cos(s.el);
+  camera.position.set(target.x + s.dist * c * Math.cos(s.az), target.y + s.dist * Math.sin(s.el), target.z + s.dist * c * Math.sin(s.az));
+  const forward = target.clone().sub(camera.position).normalize();
+  const right = forward.clone().cross(camera.up).normalize();
+  const up = right.clone().cross(forward).normalize();
+  // Moving camera and look-at point together to the right/up draws the scene left/down on screen.
+  const shift = right.multiplyScalar(FRAME_SHIFT_RIGHT * s.dist).add(up.multiplyScalar(FRAME_SHIFT_UP * s.dist));
+  camera.position.add(shift);
+  const lookAt = target.clone().add(shift);
+  camera.lookAt(lookAt);
+  return lookAt;
+}
+
+/** Inverse of place(): spherical position and unshifted target of the camera as it is now. */
+function current(camera: THREE.Camera, lookAt: THREE.Vector3): { s: Spherical; target: THREE.Vector3 } {
+  const s = toSpherical(camera.position, lookAt);
+  const forward = lookAt.clone().sub(camera.position).normalize();
+  const right = forward.clone().cross(camera.up).normalize();
+  const up = right.clone().cross(forward).normalize();
+  const shift = right.multiplyScalar(FRAME_SHIFT_RIGHT * s.dist).add(up.multiplyScalar(FRAME_SHIFT_UP * s.dist));
+  return { s, target: lookAt.clone().sub(shift) };
+}
+
+/** Slow start, slow stop. */
+function easeInOutCubic(t: number): number {
+  return t < 0.5 ? 4 * t * t * t : 1 - (-2 * t + 2) ** 3 / 2;
+}
+
+/** Shortest signed angle from a to b. */
+function angleDelta(a: number, b: number): number {
+  return Math.atan2(Math.sin(b - a), Math.cos(b - a));
+}
+
+export const cameraTourAddon: RobotSceneAddon = (ctx) => {
+  const { camera, controls } = ctx;
+  let next = 0;
+  let move: { from: Spherical; fromTarget: THREE.Vector3; to: Spherical; start: number } | null = null;
+  // Start as if a hold just ended, so the first move waits for the arm to work.
+  let holdStart = performance.now() - HOLD_MS;
+  let pausedUntil = 0;
+  let lastTip: THREE.Vector3 | null = null;
+  let lastMotion = -Infinity;
+
+  const onUserStart = () => {
+    move = null;
+    pausedUntil = performance.now() + USER_PAUSE_MS;
+  };
+  controls.addEventListener('start', onUserStart);
+
+  const unsubscribe = ctx.onBeforeRender(() => {
+    const now = performance.now();
+    const tip = ctx.getTipWorldPosition();
+    if (tip) {
+      if (lastTip && tip.distanceTo(lastTip) > TIP_MOVE_M) lastMotion = now;
+      if (!lastTip || tip.distanceTo(lastTip) > TIP_MOVE_M) lastTip = tip;
+    }
+    if (now < pausedUntil) {
+      holdStart = now;
+      return;
+    }
+
+    if (move) {
+      const t = Math.min(1, (now - move.start) / MOVE_MS);
+      const k = easeInOutCubic(t);
+      const target = move.fromTarget.clone().lerp(TARGET, k);
+      const lookAt = place(camera, target, {
+        az: move.from.az + angleDelta(move.from.az, move.to.az) * k,
+        el: move.from.el + (move.to.el - move.from.el) * k,
+        dist: move.from.dist + (move.to.dist - move.from.dist) * k,
+      });
+      controls.target.copy(lookAt);
+      if (t >= 1) {
+        move = null;
+        holdStart = now;
+      }
+      return;
+    }
+
+    const armWorking = now - lastMotion < ACTIVE_WINDOW_MS;
+    if (armWorking && now - holdStart >= HOLD_MS) {
+      const here = current(camera, controls.target);
+      move = {
+        from: here.s,
+        fromTarget: here.target,
+        to: fromView(VIEWS[next]),
+        start: now,
+      };
+      next = (next + 1) % VIEWS.length;
+    }
+  });
+
+  return () => {
+    controls.removeEventListener('start', onUserStart);
+    unsubscribe();
+  };
+};
