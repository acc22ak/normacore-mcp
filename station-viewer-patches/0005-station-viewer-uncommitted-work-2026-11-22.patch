@@ -0,0 +1,32 @@
+import type { st3215 } from '@/api/proto.js';
+import { getMotorPosition, hasMotorPosition, rawToNormalizedPosition } from '../motor-parser';
+
+/**
+ * Normalized positions and statuses for drawing the arm, indexed by motor id - 1.
+ *
+ * A motor whose read failed arrives with `error` set and no usable register dump. Drawing that as
+ * position 0 made the joint snap to the end of its range for a frame or two and back (the arm
+ * "glitched" whenever a motor reported an error). Such a motor keeps the last position that was
+ * actually read (`lastGood`, by motor id); it is still marked as in error, so it is tinted.
+ */
+export function readArmPose(
+  motors: st3215.InferenceState.IMotorState[],
+  lastGood: Map<number, number>,
+): { positions: number[]; statuses: ('ok' | 'error')[] } {
+  const positions: number[] = [];
+  const statuses: ('ok' | 'error')[] = [];
+  for (const motor of motors) {
+    if (!motor || motor.id === null || motor.id === undefined) continue;
+    const index = motor.id - 1;
+    if (hasMotorPosition(motor)) {
+      const position = rawToNormalizedPosition(motor, getMotorPosition(motor.state as Uint8Array));
+      lastGood.set(motor.id, position);
+      positions[index] = position;
+    } else {
+      // No reading: hold the last one; a motor never read yet sits mid-range, not at an end stop.
+      positions[index] = lastGood.get(motor.id) ?? 0.5;
+    }
+    statuses[index] = motor.error ? 'error' : 'ok';
+  }
+  return { positions, statuses };
+}
