@@ -0,0 +1,106 @@
+import * as THREE from 'three';
+
+/**
+ * Geometry for the "grab ball": the handle above the gripper that the user drags to
+ * position the arm. Pure functions, no scene access.
+ *
+ * Plain drag slides the ball over a horizontal plane (height stays). Shift + drag moves
+ * it straight up and down (position over the table stays).
+ */
+
+/** Space the arm must stay out of. World frame: metres, Y up, the arm faces +X. */
+export interface KeepOut {
+  /** Height of the table top. */
+  tableY: number;
+  /** Nothing may go behind this X (the wall or edge at the robot's back). Null: no limit. */
+  backX: number | null;
+  /** Clearance kept from both. */
+  margin: number;
+}
+
+export interface DragAnchor {
+  hit: THREE.Vector3 | null;
+  lift: boolean;
+}
+
+const MAX_STEP_M = 0.05; // per pointer event: a grazing ray can hit the plane metres away
+
+/**
+ * Next ball position for a pointer ray. `anchor` carries the last hit between calls; it is
+ * re-seated (and the ball left where it is) whenever the mode changes, so pressing or
+ * releasing Shift mid-drag never makes the ball jump.
+ */
+export function dragBall(
+  ray: THREE.Ray,
+  ball: THREE.Vector3,
+  lift: boolean,
+  cameraDirection: THREE.Vector3,
+  anchor: DragAnchor,
+): THREE.Vector3 {
+  const normal = new THREE.Vector3(0, 1, 0);
+  if (lift) {
+    // A vertical plane through the ball, facing the camera.
+    normal.set(cameraDirection.x, 0, cameraDirection.z);
+    if (normal.lengthSq() < 1e-6) normal.set(1, 0, 0); // looking straight down
+    normal.normalize();
+  }
+  const plane = new THREE.Plane().setFromNormalAndCoplanarPoint(normal, ball);
+  const hit = ray.intersectPlane(plane, new THREE.Vector3());
+  if (!hit) return ball.clone();
+  if (!anchor.hit || anchor.lift !== lift) {
+    anchor.hit = hit;
+    anchor.lift = lift;
+    return ball.clone();
+  }
+  const delta = hit.clone().sub(anchor.hit);
+  anchor.hit = hit;
+  if (lift) delta.set(0, delta.y, 0);
+  else delta.y = 0;
+  if (delta.length() > MAX_STEP_M) delta.setLength(MAX_STEP_M);
+  return ball.clone().add(delta);
+}
+
+/** How far (m) the lowest / rearmost point of the arm is inside the keep-out space; 0 when clear. */
+export function penetration(minY: number, minX: number, keepOut: KeepOut): number {
+  const table = keepOut.tableY + keepOut.margin - minY;
+  const back = keepOut.backX === null ? 0 : keepOut.backX + keepOut.margin - minX;
+  return Math.max(0, table, back);
+}
+
+export interface Limited<T> {
+  position: THREE.Vector3;
+  /** What `evaluate` returned at `position`; null when not even the first step was allowed. */
+  value: T | null;
+  blocked: boolean;
+}
+
+/**
+ * The point closest to `to` on the segment from `from` that stays allowed. `from` is taken
+ * as allowed. `evaluate` solves the arm for a ball position and reports its penetration;
+ * `allowed` is the penetration tolerated (the start pose's own, so an arm that begins
+ * inside the keep-out space can still move out of it, never further in).
+ */
+export function furthestAllowed<T>(
+  from: THREE.Vector3,
+  to: THREE.Vector3,
+  evaluate: (position: THREE.Vector3) => { penetration: number; value: T },
+  allowed: number,
+  steps = 4,
+): Limited<T> {
+  const direct = evaluate(to);
+  if (direct.penetration <= allowed) return { position: to.clone(), value: direct.value, blocked: false };
+  let low = 0;
+  let high = 1;
+  let best: T | null = null;
+  for (let i = 0; i < steps; i++) {
+    const mid = (low + high) / 2;
+    const result = evaluate(from.clone().lerp(to, mid));
+    if (result.penetration <= allowed) {
+      low = mid;
+      best = result.value;
+    } else {
+      high = mid;
+    }
+  }
+  return { position: from.clone().lerp(to, low), value: best, blocked: true };
+}
