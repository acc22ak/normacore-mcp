@@ -0,0 +1,132 @@
+import * as THREE from 'three';
+import type { RealsenseIntrinsics } from './protocol';
+
+// Camera pose in the 3D view's world frame: origin at the robot base, metres, Y up
+// (the ElRobot URDF's Z-up frame is rotated into three.js' Y-up by its baseRpy).
+// The arm's front faces +Z, so a camera "in front of the arm" has a positive z.
+//
+// Orientation is a three.js Euler in 'YXZ' order (yaw, then pitch, then roll) applied
+// to a three.js-style camera that looks down its local -Z with +Y up. With all angles 0
+// the camera looks from +Z back toward the robot; negative pitch tilts it down.
+
+export interface CameraPose {
+  x: number;
+  y: number;
+  z: number;
+  yaw: number;
+  pitch: number;
+  roll: number;
+}
+
+const DEG = Math.PI / 180;
+
+export const DEFAULT_CAMERA_POSE: CameraPose = {
+  x: 0,
+  y: 0.3,
+  z: 0.55,
+  yaw: 0,
+  pitch: -20 * DEG,
+  roll: 0,
+};
+
+const STORAGE_PREFIX = 'realsense.cameraPose.';
+const DEFAULT_KEY = 'default';
+
+type PoseListener = (pose: CameraPose) => void;
+const listeners = new Set<PoseListener>();
+const cache = new Map<string, CameraPose>();
+
+function storageKey(serial: string | null | undefined): string {
+  return STORAGE_PREFIX + (serial || DEFAULT_KEY);
+}
+
+let activeSerial: string | null = null;
+
+/** Which camera's pose the 3D view and the align panel use (set from the bridge status). */
+export function setActiveCameraSerial(serial: string | null): void {
+  if (serial === activeSerial) return;
+  activeSerial = serial;
+  const pose = getCameraPose();
+  listeners.forEach((l) => l(pose));
+}
+
+export function getCameraPose(): CameraPose {
+  const key = storageKey(activeSerial);
+  const cached = cache.get(key);
+  if (cached) return cached;
+  let pose = DEFAULT_CAMERA_POSE;
+  try {
+    const raw = window.localStorage.getItem(key);
+    if (raw) {
+      const parsed = JSON.parse(raw);
+      if (['x', 'y', 'z', 'yaw', 'pitch', 'roll'].every((k) => Number.isFinite(parsed?.[k]))) {
+        pose = parsed as CameraPose;
+      }
+    }
+  } catch {
+    // ignore unreadable storage
+  }
+  cache.set(key, pose);
+  return pose;
+}
+
+/** True when this browser has a saved pose for the active camera (not just the default). */
+export function hasStoredCameraPose(): boolean {
+  try {
+    return window.localStorage.getItem(storageKey(activeSerial)) !== null;
+  } catch {
+    return false;
+  }
+}
+
+export function setCameraPose(pose: CameraPose): void {
+  const key = storageKey(activeSerial);
+  cache.set(key, pose);
+  try {
+    window.localStorage.setItem(key, JSON.stringify(pose));
+  } catch {
+    // storage full or blocked: keep the in-memory pose
+  }
+  listeners.forEach((l) => l(pose));
+}
+
+export function subscribeCameraPose(listener: PoseListener): () => void {
+  listeners.add(listener);
+  return () => {
+    listeners.delete(listener);
+  };
+}
+
+export function applyPoseToObject(pose: CameraPose, object: THREE.Object3D): void {
+  object.position.set(pose.x, pose.y, pose.z);
+  object.rotation.set(pose.pitch, pose.yaw, pose.roll, 'YXZ');
+}
+
+export function poseFromRigid(rotation: THREE.Quaternion, translation: THREE.Vector3): CameraPose {
+  const euler = new THREE.Euler().setFromQuaternion(rotation, 'YXZ');
+  return {
+    x: translation.x,
+    y: translation.y,
+    z: translation.z,
+    yaw: euler.y,
+    pitch: euler.x,
+    roll: euler.z,
+  };
+}
+
+/**
+ * Deproject a depth-grid pixel to a point in the camera rig's local frame.
+ * RealSense optical frame is x right, y down, z forward; the rig is a three.js camera
+ * (x right, y up, looking down -z), so y and z flip.
+ */
+export function deprojectToLocal(
+  u: number,
+  v: number,
+  depthM: number,
+  intr: RealsenseIntrinsics,
+  out = new THREE.Vector3(),
+): THREE.Vector3 {
+  const x = ((u - intr.ppx) * depthM) / intr.fx;
+  const y = ((v - intr.ppy) * depthM) / intr.fy;
+  return out.set(x, -y, -depthM);
+}
