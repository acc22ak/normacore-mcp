+++ b/software/station/clients/station-viewer/src/realsense/RealsenseFeed.tsx
@@ -0,0 +1,170 @@
+import { useEffect, useRef, useState } from 'react';
+import { colorizeDepth } from './depth-colormap';
+import type { RealsenseFrame } from './protocol';
+import { sampleDepthMm } from './protocol';
+import { getLatestRealsenseFrame, subscribeRealsenseFrames } from './realsense-store';
+
+export type RealsenseFeedMode = 'color' | 'depth';
+
+/** Redraw cap for the 2D feed; keeps the page's main thread free for the robot data. */
+const FEED_MAX_FPS = 10;
+
+export interface RealsenseFeedMarker {
+  id: number;
+  /** Depth-grid pixel. */
+  u: number;
+  v: number;
+}
+
+interface RealsenseFeedProps {
+  mode: RealsenseFeedMode;
+  className?: string;
+  /** Called with depth-grid pixel coordinates and the frame that was on screen. */
+  onPick?: (frame: RealsenseFrame, u: number, v: number) => void;
+  markers?: RealsenseFeedMarker[];
+}
+
+// Draws the newest RealSense frame on a canvas (frames never enter React state).
+// Shows the depth under the cursor; clicking reports the depth-grid pixel.
+function RealsenseFeed({ mode, className = '', onPick, markers }: RealsenseFeedProps) {
+  const canvasRef = useRef<HTMLCanvasElement>(null);
+  const frameRef = useRef<RealsenseFrame | null>(null);
+  const modeRef = useRef(mode);
+  modeRef.current = mode;
+  const [hover, setHover] = useState<{ x: number; y: number; text: string } | null>(null);
+
+  useEffect(() => {
+    const canvas = canvasRef.current;
+    if (!canvas) return;
+    const ctx = canvas.getContext('2d');
+    if (!ctx) return;
+    let busy = false;
+    let disposed = false;
+    let depthImage: ImageData | null = null;
+    let depthCanvas: OffscreenCanvas | null = null;
+
+    const draw = async (frame: RealsenseFrame) => {
+      const { color, depth } = frame.header;
+      if (canvas.width !== color.w || canvas.height !== color.h) {
+        canvas.width = color.w;
+        canvas.height = color.h;
+      }
+      if (modeRef.current === 'color') {
+        const bitmap = await createImageBitmap(new Blob([frame.jpeg as BlobPart], { type: 'image/jpeg' }));
+        if (!disposed) ctx.drawImage(bitmap, 0, 0, canvas.width, canvas.height);
+        bitmap.close();
+        return;
+      }
+      if (!depthImage || depthImage.width !== depth.w || depthImage.height !== depth.h) {
+        depthImage = new ImageData(depth.w, depth.h);
+        depthCanvas = new OffscreenCanvas(depth.w, depth.h);
+      }
+      colorizeDepth(frame.depth, depthImage.data);
+      const dctx = depthCanvas?.getContext('2d');
+      if (!dctx || !depthCanvas) return;
+      dctx.putImageData(depthImage, 0, 0);
+      ctx.fillStyle = '#000';
+      ctx.fillRect(0, 0, canvas.width, canvas.height);
+      ctx.imageSmoothingEnabled = false;
+      ctx.drawImage(depthCanvas, 0, 0, canvas.width, canvas.height);
+    };
+
+    let lastDraw = 0;
+    const unsubscribe = subscribeRealsenseFrames((frame) => {
+      frameRef.current = frame;
+      if (busy || disposed || document.hidden) return;
+      const now = performance.now();
+      if (now - lastDraw < 1000 / FEED_MAX_FPS) return;
+      lastDraw = now;
+      busy = true;
+      draw(frame).catch(() => {}).finally(() => {
+        busy = false;
+      });
+    });
+    return () => {
+      disposed = true;
+      unsubscribe();
+    };
+  }, [mode]);
+
+  const toDepthPixel = (event: React.MouseEvent<HTMLCanvasElement>) => {
+    const frame = frameRef.current ?? getLatestRealsenseFrame();
+    const canvas = canvasRef.current;
+    if (!frame || !canvas) return null;
+    const rect = canvas.getBoundingClientRect();
+    // object-contain letterboxing: find the drawn image area inside the element.
+    const scale = Math.min(rect.width / canvas.width, rect.height / canvas.height);
+    const drawnW = canvas.width * scale;
+    const drawnH = canvas.height * scale;
+    const offX = (rect.width - drawnW) / 2;
+    const offY = (rect.height - drawnH) / 2;
+    const px = (event.clientX - rect.left - offX) / drawnW;
+    const py = (event.clientY - rect.top - offY) / drawnH;
+    if (px < 0 || px > 1 || py < 0 || py > 1) return null;
+    const { w, h } = frame.header.depth;
+    return {
+      frame,
+      u: Math.min(w - 1, px * w),
+      v: Math.min(h - 1, py * h),
+      x: event.clientX - rect.left,
+      y: event.clientY - rect.top,
+    };
+  };
+
+  const handleMove = (event: React.MouseEvent<HTMLCanvasElement>) => {
+    const hit = toDepthPixel(event);
+    if (!hit) {
+      setHover(null);
+      return;
+    }
+    const mm = sampleDepthMm(hit.frame, hit.u, hit.v, 1);
+    setHover({ x: hit.x, y: hit.y, text: mm === null ? 'no depth' : `${(mm / 10).toFixed(1)} cm` });
+  };
+
+  const handleClick = (event: React.MouseEvent<HTMLCanvasElement>) => {
+    if (!onPick) return;
+    const hit = toDepthPixel(event);
+    if (hit) onPick(hit.frame, hit.u, hit.v);
+  };
+
+  const frame = frameRef.current;
+  return (
+    <div className={`relative overflow-hidden bg-black ${className}`}>
+      <canvas
+        ref={canvasRef}
+        width={640}
+        height={480}
+        onMouseMove={handleMove}
+        onMouseLeave={() => setHover(null)}
+        onClick={handleClick}
+        className={`h-full w-full object-contain ${onPick ? 'cursor-crosshair' : 'cursor-default'}`}
+        aria-label={mode === 'color' ? 'RealSense color image' : 'RealSense depth image'}
+      />
+      {markers && frame && markers.length > 0 && (
+        <svg
+          className="pointer-events-none absolute inset-0 h-full w-full"
+          viewBox={`0 0 ${frame.header.depth.w} ${frame.header.depth.h}`}
+          preserveAspectRatio="xMidYMid meet"
+          aria-hidden
+        >
+          {markers.map((m, i) => (
+            <g key={m.id}>
+              <circle cx={m.u} cy={m.v} r={3} fill="none" stroke="#f0a830" strokeWidth={1} />
+              <text x={m.u + 4} y={m.v - 4} fontSize={8} fill="#f0a830">{i + 1}</text>
+            </g>
+          ))}
+        </svg>
+      )}
+      {hover && (
+        <div
+          className="pointer-events-none absolute rounded bg-surface-base/80 px-1.5 py-0.5 font-mono text-[11px] text-text-primary"
+          style={{ left: hover.x + 12, top: hover.y + 12 }}
+        >
+          {hover.text}
+        </div>
+      )}
+    </div>
+  );
+}
+
+export default RealsenseFeed;
