+
+/**
+ * Inverse of the renderer's normalization: a 0..1 position inside the motor's
+ * calibrated range to a raw goal position (handles ranges that wrap past 4095).
+ */
+export function normalizedToRawPosition(motor: st3215.InferenceState.IMotorState, normalized: number): number {
+  const { min, max } = getEffectiveMotorRange(motor);
+  const p = Math.max(0, Math.min(1, normalized));
+  if (min > max) {
+    const total = (MAX_ANGLE_STEP - min) + max;
+    return Math.round(min + p * total) % (MAX_ANGLE_STEP + 1);
+  }
+  return Math.round(min + p * (max - min));
+}
+
+/** Inverse of normalizedToRawPosition: where a raw position sits (0..1) in the motor's calibrated range. */
+export function rawToNormalizedPosition(motor: st3215.InferenceState.IMotorState, raw: number): number {
+  const { min, max } = getEffectiveMotorRange(motor);
+  if (min > max) {
+    const total = (MAX_ANGLE_STEP - min) + max;
+    if (total === 0) return 0;
+    return (raw >= min ? raw - min : MAX_ANGLE_STEP - min + raw) / total;
+  }
+  return max === min ? 0 : (raw - min) / (max - min);
+}
