+import { describe, expect, it } from 'vitest';
+import { readArmPose } from './arm-pose';
+
+// Register dump with the present position (0x38, little-endian) set.
+function dump(position: number): Uint8Array {
+  const data = new Uint8Array(0x47);
+  data[0x38] = position & 0xff;
+  data[0x39] = (position >> 8) & 0xff;
+  return data;
+}
+
+describe('readArmPose', () => {
+  it('holds a joint where it was when its motor reports an error with no data', () => {
+    const lastGood = new Map<number, number>();
+    const healthy = [{ id: 1, state: dump(2000), rangeMin: 1000, rangeMax: 3000 }];
+    expect(readArmPose(healthy, lastGood).positions[0]).toBeCloseTo(0.5);
+
+    // The failed read: an error and an empty dump. Before the fix this drew the joint at 0.
+    const failed = [{ id: 1, state: new Uint8Array(0), rangeMin: 1000, rangeMax: 3000, error: { description: 'timeout' } }];
+    const pose = readArmPose(failed, lastGood);
+    expect(pose.positions[0]).toBeCloseTo(0.5);
+    expect(pose.statuses[0]).toBe('error');
+  });
+
+  it('still follows a motor that reports an error together with a valid reading', () => {
+    const lastGood = new Map<number, number>([[1, 0.5]]);
+    const overheated = [{ id: 1, state: dump(2500), rangeMin: 1000, rangeMax: 3000, error: { description: 'overheat' } }];
+    expect(readArmPose(overheated, lastGood).positions[0]).toBeCloseTo(0.75);
+  });
+});
