@@ -0,0 +1,316 @@
+import * as THREE from 'three';
+import type { RobotSceneAddon } from '@/st3215/robot-rendering/types';
+import { applyPoseToObject, getCameraPose, subscribeCameraPose } from './camera-pose';
+import { getCalibrationState, registerIkProvider, registerSurfaceProvider, registerTipProvider } from './calibration-store';
+import type { RealsenseFrame } from './protocol';
+import { subscribeRealsenseFrames } from './realsense-store';
+
+// Adds the RealSense point cloud, a camera frustum and (while calibrating) a tip marker
+// to an arm's 3D view. Points are deprojected on the CPU (≤ 76,800 per frame at 15 fps)
+// into two preallocated layers: table points (dimmed, larger dots) and everything above the table
+// (arm, objects: full colour, smaller dots); each is packed at the front and drawn with a draw range.
+
+const FRUSTUM_DEPTH_M = 0.08;
+/**
+ * Temporal smoothing of each pixel's depth, against the ±few-mm per-frame noise that makes dots flicker.
+ * A change smaller than the jump threshold is blended in (weight below); a bigger one is something that
+ * really moved and is taken at once. A pixel that drops out keeps its last depth for a few frames.
+ */
+const SMOOTH_WEIGHT_NEW = 0.3;
+const SMOOTH_JUMP_M = 0.015;
+const SMOOTH_HOLD_FRAMES = 3;
+
+/** Dot size of table points (m). */
+const TABLE_POINT_SIZE_M = 0.0035;
+/** Dot size of everything above the table (arm, objects): they are nearer the camera, so denser. */
+const OBJECT_POINT_SIZE_M = 0.0022;
+/** Use every Nth depth pixel per axis: 4× fewer points, still dense enough to read the scene. */
+const CLOUD_STRIDE = 2;
+/** Cloud refresh cap; the bridge sends ~15 fps but the 3D view doesn't need more than this. */
+const CLOUD_MAX_FPS = 6;
+/**
+ * Depth points further back than this are not drawn (world X, metres; the arm faces +X from the
+ * origin). The camera looks at the arm from the front, so everything behind the arm (people, chairs,
+ * the room) would otherwise fill the view. 10 cm keeps the folded arm and the table's back edge.
+ */
+const CLOUD_MIN_WORLD_X_M = -0.10;
+/**
+ * Points this close to the table plane (world Y, metres; the calibration puts the table at y = 0) are
+ * drawn dimmed so the objects on it stand out. 6 mm is above the table's depth noise (~±3 mm) and below
+ * a lying pen (~8 mm).
+ */
+const TABLE_DIM_MAX_Y_M = 0.006;
+/** Brightness kept by table points (0..1). */
+const TABLE_DIM_FACTOR = 0.2;
+/** Points above the table: colours pushed away from grey by this much (1 = unchanged)... */
+const OBJECT_SATURATION = 1.6;
+/** ...then brightened by this factor (clamped to white). */
+const OBJECT_BRIGHTNESS = 1.3;
+
+/** One drawn set of points (table or objects), packed at the front of reusable buffers. */
+interface CloudLayer {
+  geometry: THREE.BufferGeometry;
+  material: THREE.PointsMaterial;
+  positions: Float32Array;
+  colors: Uint8Array;
+  capacity: number;
+  count: number;
+}
+
+function createLayer(size: number, map: THREE.Texture, rig: THREE.Object3D): CloudLayer {
+  const geometry = new THREE.BufferGeometry();
+  const material = new THREE.PointsMaterial({ size, vertexColors: true, sizeAttenuation: true, map, alphaTest: 0.5 });
+  const points = new THREE.Points(geometry, material);
+  points.frustumCulled = false;
+  points.raycast = () => {};
+  rig.add(points);
+  return { geometry, material, positions: new Float32Array(0), colors: new Uint8Array(0), capacity: 0, count: 0 };
+}
+
+function ensureLayerCapacity(layer: CloudLayer, n: number): void {
+  if (n <= layer.capacity) return;
+  layer.capacity = n;
+  layer.positions = new Float32Array(n * 3);
+  layer.colors = new Uint8Array(n * 3);
+  layer.geometry.setAttribute('position', new THREE.BufferAttribute(layer.positions, 3).setUsage(THREE.DynamicDrawUsage));
+  layer.geometry.setAttribute('color', new THREE.BufferAttribute(layer.colors, 3, true).setUsage(THREE.DynamicDrawUsage));
+}
+
+function publishLayer(layer: CloudLayer): void {
+  const n = layer.count;
+  layer.geometry.setDrawRange(0, n);
+  for (const name of ['position', 'color']) {
+    const attr = layer.geometry.getAttribute(name) as THREE.BufferAttribute | undefined;
+    if (!attr) continue;
+    attr.clearUpdateRanges();
+    attr.addUpdateRange(0, n * 3);
+    attr.needsUpdate = true;
+  }
+}
+
+/** A white disc on transparent: makes each point a round dot instead of a square. */
+function buildDiscTexture(): THREE.Texture {
+  const size = 64;
+  const c = document.createElement('canvas');
+  c.width = c.height = size;
+  const g = c.getContext('2d');
+  if (g) {
+    g.fillStyle = '#ffffff';
+    g.beginPath();
+    g.arc(size / 2, size / 2, size / 2 - 1, 0, Math.PI * 2);
+    g.fill();
+  }
+  const t = new THREE.CanvasTexture(c);
+  t.colorSpace = THREE.SRGBColorSpace;
+  return t;
+}
+
+function buildFrustum(frame: RealsenseFrame | null): THREE.BufferGeometry {
+  // D435 color FOV ≈ 69° × 42° until the first frame brings the intrinsics.
+  let halfW = Math.tan((69 / 2) * (Math.PI / 180)) * FRUSTUM_DEPTH_M;
+  let halfH = Math.tan((42 / 2) * (Math.PI / 180)) * FRUSTUM_DEPTH_M;
+  if (frame) {
+    const { fx, fy } = frame.header.intrinsics;
+    halfW = (frame.header.depth.w / 2 / fx) * FRUSTUM_DEPTH_M;
+    halfH = (frame.header.depth.h / 2 / fy) * FRUSTUM_DEPTH_M;
+  }
+  const d = -FRUSTUM_DEPTH_M;
+  const c = [
+    [-halfW, halfH, d],
+    [halfW, halfH, d],
+    [halfW, -halfH, d],
+    [-halfW, -halfH, d],
+  ];
+  const v: number[] = [];
+  c.forEach((p) => v.push(0, 0, 0, ...p));
+  for (let i = 0; i < 4; i++) v.push(...c[i], ...c[(i + 1) % 4]);
+  // Small "up" tick so the image orientation is visible.
+  v.push(-halfW * 0.3, halfH, d, 0, halfH * 1.4, d, 0, halfH * 1.4, d, halfW * 0.3, halfH, d);
+  const g = new THREE.BufferGeometry();
+  g.setAttribute('position', new THREE.Float32BufferAttribute(v, 3));
+  return g;
+}
+
+export const realsensePointCloudAddon: RobotSceneAddon = (ctx) => {
+  const rig = new THREE.Group();
+  rig.name = 'realsense-camera';
+  applyPoseToObject(getCameraPose(), rig);
+  ctx.scene.add(rig);
+
+  const discTexture = buildDiscTexture();
+  const tableLayer = createLayer(TABLE_POINT_SIZE_M, discTexture, rig);
+  const objectLayer = createLayer(OBJECT_POINT_SIZE_M, discTexture, rig);
+
+  const frustumMaterial = new THREE.LineBasicMaterial({ color: 0xf0a830 });
+  const frustum = new THREE.LineSegments(buildFrustum(null), frustumMaterial);
+  frustum.raycast = () => {};
+  rig.add(frustum);
+  let frustumFromFrame = false;
+
+  const tipMarker = new THREE.Mesh(
+    new THREE.SphereGeometry(0.008, 16, 12),
+    new THREE.MeshBasicMaterial({ color: 0xf0a830, depthTest: false, transparent: true, opacity: 0.9 }),
+  );
+  tipMarker.renderOrder = 10;
+  tipMarker.visible = false;
+  tipMarker.raycast = () => {};
+  ctx.scene.add(tipMarker);
+
+  let canvas: OffscreenCanvas | null = null;
+  let canvasCtx: OffscreenCanvasRenderingContext2D | null = null;
+  let busy = false;
+  let disposed = false;
+  // Per sampled pixel: smoothed depth (m, 0 = none yet) and frames since the last real reading.
+  let smoothDepth = new Float32Array(0);
+  let missed = new Uint8Array(0);
+  let smoothW = 0;
+  let smoothH = 0;
+
+  const processFrame = async (frame: RealsenseFrame) => {
+    const { w, h, unit_m } = frame.header.depth;
+    const { fx, fy, ppx, ppy } = frame.header.intrinsics;
+
+    // Color at depth resolution (depth is aligned to color, so pixel (u,v) matches).
+    let rgba: Uint8ClampedArray | null = null;
+    try {
+      const bitmap = await createImageBitmap(new Blob([frame.jpeg as BlobPart], { type: 'image/jpeg' }));
+      if (disposed) {
+        bitmap.close();
+        return;
+      }
+      if (!canvas || canvas.width !== w || canvas.height !== h) {
+        canvas = new OffscreenCanvas(w, h);
+        canvasCtx = canvas.getContext('2d', { willReadFrequently: true });
+      }
+      if (canvasCtx) {
+        canvasCtx.drawImage(bitmap, 0, 0, w, h);
+        rgba = canvasCtx.getImageData(0, 0, w, h).data;
+      }
+      bitmap.close();
+    } catch {
+      rgba = null;
+    }
+
+    const maxPoints = Math.ceil(w / CLOUD_STRIDE) * Math.ceil(h / CLOUD_STRIDE);
+    ensureLayerCapacity(tableLayer, maxPoints);
+    ensureLayerCapacity(objectLayer, maxPoints);
+    tableLayer.count = 0;
+    objectLayer.count = 0;
+    const depth = frame.depth;
+    if (w !== smoothW || h !== smoothH) {
+      smoothW = w;
+      smoothH = h;
+      smoothDepth = new Float32Array(w * h);
+      missed = new Uint8Array(w * h);
+    }
+    // Rows 0 and 1 of the rig's matrix give a point's world X and Y from its camera-local position.
+    rig.updateMatrix();
+    const m = rig.matrix.elements;
+    for (let v = 0; v < h; v += CLOUD_STRIDE) {
+      const yk = (v - ppy) / fy;
+      for (let u = 0; u < w; u += CLOUD_STRIDE) {
+        const i = v * w + u;
+        const raw = depth[i] * unit_m;
+        const prev = smoothDepth[i];
+        let z: number;
+        if (raw === 0) {
+          if (prev === 0 || missed[i] >= SMOOTH_HOLD_FRAMES) {
+            smoothDepth[i] = 0;
+            continue;
+          }
+          missed[i]++;
+          z = prev;
+        } else {
+          missed[i] = 0;
+          z = prev === 0 || Math.abs(raw - prev) > SMOOTH_JUMP_M ? raw : prev + (raw - prev) * SMOOTH_WEIGHT_NEW;
+          smoothDepth[i] = z;
+        }
+        // Optical (x right, y down, z forward) -> rig local (x right, y up, -z forward).
+        const lx = ((u - ppx) / fx) * z;
+        const ly = -yk * z;
+        if (m[0] * lx + m[4] * ly - m[8] * z + m[12] < CLOUD_MIN_WORLD_X_M) continue; // behind the arm
+        const worldY = m[1] * lx + m[5] * ly - m[9] * z + m[13];
+        const onTable = worldY < TABLE_DIM_MAX_Y_M;
+        const layer = onTable ? tableLayer : objectLayer;
+        const { positions, colors } = layer;
+        const o = layer.count * 3;
+        positions[o] = lx;
+        positions[o + 1] = ly;
+        positions[o + 2] = -z;
+        const r = rgba ? rgba[i * 4] : 200;
+        const g = rgba ? rgba[i * 4 + 1] : 200;
+        const b = rgba ? rgba[i * 4 + 2] : 200;
+        if (onTable) {
+          colors[o] = r * TABLE_DIM_FACTOR;
+          colors[o + 1] = g * TABLE_DIM_FACTOR;
+          colors[o + 2] = b * TABLE_DIM_FACTOR;
+        } else {
+          // Uint8Array wraps values past 255 instead of clamping, so clamp each channel here.
+          const grey = (r + g + b) / 3;
+          colors[o] = Math.min(255, Math.max(0, (grey + (r - grey) * OBJECT_SATURATION) * OBJECT_BRIGHTNESS));
+          colors[o + 1] = Math.min(255, Math.max(0, (grey + (g - grey) * OBJECT_SATURATION) * OBJECT_BRIGHTNESS));
+          colors[o + 2] = Math.min(255, Math.max(0, (grey + (b - grey) * OBJECT_SATURATION) * OBJECT_BRIGHTNESS));
+        }
+        layer.count++;
+      }
+    }
+    publishLayer(tableLayer);
+    publishLayer(objectLayer);
+
+    if (!frustumFromFrame) {
+      frustum.geometry.dispose();
+      frustum.geometry = buildFrustum(frame);
+      frustumFromFrame = true;
+    }
+  };
+
+  let lastProcessed = 0;
+  const unsubscribeFrames = subscribeRealsenseFrames((frame) => {
+    // Drop frames while the previous one is still decoding, above the fps cap, or when hidden.
+    if (busy || disposed || document.hidden) return;
+    const now = performance.now();
+    if (now - lastProcessed < 1000 / CLOUD_MAX_FPS) return;
+    lastProcessed = now;
+    busy = true;
+    processFrame(frame).finally(() => {
+      busy = false;
+    });
+  });
+
+  const unsubscribePose = subscribeCameraPose((pose) => applyPoseToObject(pose, rig));
+  const unregisterTip = registerTipProvider(ctx.getTipWorldPosition);
+  const unregisterSurface = registerSurfaceProvider(ctx.getRobotSurfacePoints);
+  const unregisterIk = registerIkProvider(ctx.solveTipIk);
+
+  const unsubscribeRender = ctx.onBeforeRender(() => {
+    const calibrating = getCalibrationState().active;
+    if (!calibrating) {
+      tipMarker.visible = false;
+      return;
+    }
+    const tip = ctx.getTipWorldPosition();
+    tipMarker.visible = Boolean(tip);
+    if (tip) tipMarker.position.copy(tip);
+  });
+
+  return () => {
+    disposed = true;
+    unsubscribeFrames();
+    unsubscribePose();
+    unregisterTip();
+    unregisterSurface();
+    unregisterIk();
+    unsubscribeRender();
+    ctx.scene.remove(rig);
+    ctx.scene.remove(tipMarker);
+    for (const layer of [tableLayer, objectLayer]) {
+      layer.geometry.dispose();
+      layer.material.dispose();
+    }
+    discTexture.dispose();
+    frustum.geometry.dispose();
+    frustumMaterial.dispose();
+    tipMarker.geometry.dispose();
+    (tipMarker.material as THREE.Material).dispose();
+  };
+};
