+import * as THREE from 'three';
+import { describe, expect, it } from 'vitest';
+import { ErrDegeneratePoints, ErrTooFewPoints, fitRigid, fitYawAndPosition } from './rigid-fit';
+
+// A wrong rotation convention (e.g. conjugated quaternion or a w/xyz mix-up) would place the
+// point cloud mirrored or rotated in the 3D view while still producing small-looking numbers.
+
+function randomPoints(n: number, seed = 1): THREE.Vector3[] {
+  let s = seed;
+  const rnd = () => ((s = (s * 16807) % 2147483647) / 2147483647) - 0.5;
+  return Array.from({ length: n }, () => new THREE.Vector3(rnd() * 0.4, rnd() * 0.3, rnd() * 0.4));
+}
+
+describe('fitRigid', () => {
+  it('recovers a known camera pose from noisy point pairs', () => {
+    const rotation = new THREE.Quaternion().setFromEuler(new THREE.Euler(-0.4, 0.3, 0.05, 'YXZ'));
+    const translation = new THREE.Vector3(0.02, 0.3, 0.55);
+    const cameraPoints = randomPoints(6);
+    let s = 7;
+    const noise = () => (((s = (s * 48271) % 2147483647) / 2147483647) - 0.5) * 0.004;
+    const worldPoints = cameraPoints.map((p) =>
+      p.clone().applyQuaternion(rotation).add(translation).add(new THREE.Vector3(noise(), noise(), noise())),
+    );
+
+    const fit = fitRigid(cameraPoints, worldPoints);
+
+    expect(fit.translation.distanceTo(translation)).toBeLessThan(0.005);
+    expect(fit.rotation.angleTo(rotation)).toBeLessThan(0.02);
+    expect(fit.rms).toBeLessThan(0.004);
+  });
+
+  it('is exact for a 180° rotation (eigenvalue edge case)', () => {
+    const rotation = new THREE.Quaternion().setFromAxisAngle(new THREE.Vector3(0, 1, 0), Math.PI);
+    const cameraPoints = randomPoints(4, 3);
+    const worldPoints = cameraPoints.map((p) => p.clone().applyQuaternion(rotation));
+    const fit = fitRigid(cameraPoints, worldPoints);
+    expect(fit.rms).toBeLessThan(1e-6);
+  });
+
+  it('rejects too few or collinear points instead of returning an arbitrary pose', () => {
+    const a = randomPoints(2);
+    expect(() => fitRigid(a, a)).toThrow(ErrTooFewPoints);
+    const line = [0, 0.1, 0.2, 0.3].map((t) => new THREE.Vector3(t, t, 0));
+    expect(() => fitRigid(line, line)).toThrow(ErrDegeneratePoints);
+  });
+});
+
+describe('fitYawAndPosition', () => {
+  it('recovers yaw and horizontal position when tilt and height are known', () => {
+    const pose = { yaw: 1.75, pitch: -0.41, roll: -0.19, x: 0.88, y: 0.44, z: -0.01 };
+    const rotation = new THREE.Quaternion().setFromEuler(new THREE.Euler(pose.pitch, pose.yaw, pose.roll, 'YXZ'));
+    const translation = new THREE.Vector3(pose.x, pose.y, pose.z);
+    const cameraPoints = randomPoints(5, 11);
+    const worldPoints = cameraPoints.map((p) => p.clone().applyQuaternion(rotation).add(translation));
+
+    const fit = fitYawAndPosition(cameraPoints, worldPoints, pose.pitch, pose.roll, pose.y);
+
+    expect(fit.yaw).toBeCloseTo(pose.yaw, 6);
+    expect(fit.translation.distanceTo(translation)).toBeLessThan(1e-6);
+    expect(fit.rms).toBeLessThan(1e-6);
+  });
+});
diff --git a/software/station/clients/station-viewer/src/realsense/rigid-fit.ts b/software/station/clients/station-viewer/src/realsense/rigid-fit.ts
new file mode 100644
index 0000000..8e83075
--- /dev/null
+++ b/software/station/clients/station-viewer/src/realsense/rigid-fit.ts
@@ -0,0 +1,157 @@
+import * as THREE from 'three';
+
+// Rigid transform (rotation + translation, no scale) that best maps points `from` onto
+// points `to` in the least-squares sense: to ≈ R·from + t. Horn's closed-form quaternion
+// method: the rotation is the eigenvector of the largest eigenvalue of a 4×4 symmetric matrix.
+
+export interface RigidFit {
+  rotation: THREE.Quaternion;
+  translation: THREE.Vector3;
+  /** Per-pair distance after the fit, metres. */
+  errors: number[];
+  rms: number;
+}
+
+export const ErrTooFewPoints = new Error('need at least 3 point pairs');
+export const ErrDegeneratePoints = new Error('points are (nearly) on one line; spread them out');
+
+const MIN_SPREAD_M2 = 1e-5; // ~3 mm × 3 mm triangle area scale
+
+function centroid(points: THREE.Vector3[]): THREE.Vector3 {
+  const c = new THREE.Vector3();
+  points.forEach((p) => c.add(p));
+  return c.divideScalar(points.length);
+}
+
+function isDegenerate(points: THREE.Vector3[], c: THREE.Vector3): boolean {
+  const cross = new THREE.Vector3();
+  let best = 0;
+  for (let i = 0; i < points.length; i++) {
+    const a = points[i].clone().sub(c);
+    for (let j = i + 1; j < points.length; j++) {
+      const b = points[j].clone().sub(c);
+      best = Math.max(best, cross.crossVectors(a, b).length());
+    }
+  }
+  return best < MIN_SPREAD_M2;
+}
+
+/** Eigen-decomposition of a symmetric matrix by cyclic Jacobi rotations. Vectors are columns. */
+export function jacobiEigen(input: number[][]): { values: number[]; vectors: number[][] } {
+  const n = input.length;
+  const a = input.map((row) => row.slice());
+  const v: number[][] = Array.from({ length: n }, (_row, i) => Array.from({ length: n }, (_col, j) => (i === j ? 1 : 0)));
+  for (let sweep = 0; sweep < 100; sweep++) {
+    let off = 0;
+    for (let p = 0; p < n; p++) for (let q = p + 1; q < n; q++) off += a[p][q] * a[p][q];
+    if (off < 1e-30) break;
+    for (let p = 0; p < n; p++) {
+      for (let q = p + 1; q < n; q++) {
+        if (Math.abs(a[p][q]) < 1e-300) continue;
+        const theta = (a[q][q] - a[p][p]) / (2 * a[p][q]);
+        const t = Math.sign(theta || 1) / (Math.abs(theta) + Math.sqrt(theta * theta + 1));
+        const c = 1 / Math.sqrt(t * t + 1);
+        const s = t * c;
+        for (let k = 0; k < n; k++) {
+          const akp = a[k][p];
+          const akq = a[k][q];
+          a[k][p] = c * akp - s * akq;
+          a[k][q] = s * akp + c * akq;
+        }
+        for (let k = 0; k < n; k++) {
+          const apk = a[p][k];
+          const aqk = a[q][k];
+          a[p][k] = c * apk - s * aqk;
+          a[q][k] = s * apk + c * aqk;
+        }
+        for (let k = 0; k < n; k++) {
+          const vkp = v[k][p];
+          const vkq = v[k][q];
+          v[k][p] = c * vkp - s * vkq;
+          v[k][q] = s * vkp + c * vkq;
+        }
+      }
+    }
+  }
+  return { values: a.map((row, i) => row[i]), vectors: v };
+}
+
+export function fitRigid(from: THREE.Vector3[], to: THREE.Vector3[]): RigidFit {
+  if (from.length !== to.length) throw new Error('point lists differ in length');
+  if (from.length < 3) throw ErrTooFewPoints;
+  const ca = centroid(from);
+  const cb = centroid(to);
+  if (isDegenerate(from, ca) || isDegenerate(to, cb)) throw ErrDegeneratePoints;
+
+  let sxx = 0, sxy = 0, sxz = 0, syx = 0, syy = 0, syz = 0, szx = 0, szy = 0, szz = 0;
+  for (let i = 0; i < from.length; i++) {
+    const a = from[i].clone().sub(ca);
+    const b = to[i].clone().sub(cb);
+    sxx += a.x * b.x; sxy += a.x * b.y; sxz += a.x * b.z;
+    syx += a.y * b.x; syy += a.y * b.y; syz += a.y * b.z;
+    szx += a.z * b.x; szy += a.z * b.y; szz += a.z * b.z;
+  }
+  const N = [
+    [sxx + syy + szz, syz - szy, szx - sxz, sxy - syx],
+    [syz - szy, sxx - syy - szz, sxy + syx, szx + sxz],
+    [szx - sxz, sxy + syx, -sxx + syy - szz, syz + szy],
+    [sxy - syx, szx + sxz, syz + szy, -sxx - syy + szz],
+  ];
+  const { values, vectors } = jacobiEigen(N);
+  let best = 0;
+  for (let i = 1; i < 4; i++) if (values[i] > values[best]) best = i;
+  const [w, x, y, z] = [vectors[0][best], vectors[1][best], vectors[2][best], vectors[3][best]];
+  const rotation = new THREE.Quaternion(x, y, z, w).normalize();
+  const translation = cb.clone().sub(ca.clone().applyQuaternion(rotation));
+
+  const errors = from.map((p, i) => p.clone().applyQuaternion(rotation).add(translation).distanceTo(to[i]));
+  const rms = Math.sqrt(errors.reduce((s, e) => s + e * e, 0) / errors.length);
+  return { rotation, translation, errors, rms };
+}
+
+export interface LevelFit {
+  yaw: number;
+  /** Camera position; y is kept from the leveled pose. */
+  translation: THREE.Vector3;
+  errors: number[];
+  rms: number;
+}
+
+/**
+ * Fit only yaw and horizontal position when pitch, roll and height are already known (from the
+ * table plane). Camera-frame points are first tilted by Rx(pitch)·Rz(roll); what's left is a
+ * rotation about the vertical plus an XZ shift: 2D Procrustes, needs only 2 well-separated points.
+ */
+export function fitYawAndPosition(
+  from: THREE.Vector3[],
+  to: THREE.Vector3[],
+  pitch: number,
+  roll: number,
+  height: number,
+): LevelFit {
+  if (from.length !== to.length) throw new Error('point lists differ in length');
+  if (from.length < 2) throw ErrTooFewPoints;
+  const tilt = new THREE.Quaternion().setFromEuler(new THREE.Euler(pitch, 0, roll, 'YXZ'));
+  const q = from.map((p) => p.clone().applyQuaternion(tilt));
+  const cq = centroid(q);
+  const cw = centroid(to);
+  let a = 0;
+  let b = 0;
+  let spread = 0;
+  for (let i = 0; i < q.length; i++) {
+    const qx = q[i].x - cq.x, qz = q[i].z - cq.z;
+    const wx = to[i].x - cw.x, wz = to[i].z - cw.z;
+    a += wx * qx + wz * qz;
+    b += wx * qz - wz * qx;
+    spread += qx * qx + qz * qz;
+  }
+  if (spread < MIN_SPREAD_M2) throw ErrDegeneratePoints;
+  // Ry(θ)·(x, z) = (x·cosθ + z·sinθ, −x·sinθ + z·cosθ); maximize Σ w·Ry(θ)q.
+  const yaw = Math.atan2(b, a);
+  const ry = new THREE.Quaternion().setFromAxisAngle(new THREE.Vector3(0, 1, 0), yaw);
+  const rotatedCentroid = cq.clone().applyQuaternion(ry);
+  const translation = new THREE.Vector3(cw.x - rotatedCentroid.x, height, cw.z - rotatedCentroid.z);
+  const errors = q.map((p, i) => p.clone().applyQuaternion(ry).add(translation).distanceTo(to[i]));
+  const rms = Math.sqrt(errors.reduce((s, e) => s + e * e, 0) / errors.length);
+  return { yaw, translation, errors, rms };
+}
