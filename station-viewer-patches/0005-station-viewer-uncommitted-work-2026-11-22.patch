@@ -0,0 +1,258 @@
+import { useSyncExternalStore } from 'react';
+import { ALIGN_EVENT, ALIGNMENT_STORAGE_PREFIX, saveJointCalibration } from '@/st3215/robot-rendering/joint-alignment';
+import {
+  getCameraPose,
+  hasStoredCameraPose,
+  setActiveCameraSerial,
+  setCameraPose,
+  subscribeCameraPose,
+  type CameraPose,
+} from './camera-pose';
+import {
+  parseFrameMessage,
+  parseStatusMessage,
+  type RealsenseFrame,
+  type RealsenseStatusMessage,
+} from './protocol';
+
+// Live RealSense frames from realsense-bridge. Like usbvideo/live-camera-store (ADR 0007),
+// frame bytes stay out of React: components subscribe and draw imperatively. React only sees
+// the small status object.
+
+export interface RealsenseStatus {
+  /** WebSocket to the bridge is open. */
+  connected: boolean;
+  /** Bridge reports the camera streaming. */
+  streaming: boolean;
+  state: RealsenseStatusMessage['state'] | 'disconnected';
+  message: string;
+  serial: string | null;
+  firmware: string | null;
+  name: string | null;
+}
+
+type FrameListener = (frame: RealsenseFrame) => void;
+
+const DISCONNECTED: RealsenseStatus = {
+  connected: false,
+  streaming: false,
+  state: 'disconnected',
+  message: '',
+  serial: null,
+  firmware: null,
+  name: null,
+};
+
+let status: RealsenseStatus = DISCONNECTED;
+let latestFrame: RealsenseFrame | null = null;
+const frameListeners = new Set<FrameListener>();
+const statusListeners = new Set<() => void>();
+
+let socket: WebSocket | null = null;
+let retryTimer: ReturnType<typeof setTimeout> | null = null;
+let retryDelayMs = 1000;
+let started = false;
+
+function bridgeUrl(): string {
+  const override = window.localStorage.getItem('realsense.bridgeUrl');
+  if (override) return override;
+  // Vite dev server proxies /realsense to ws://127.0.0.1:8890 (vite.config.ts).
+  const scheme = window.location.protocol === 'https:' ? 'wss' : 'ws';
+  if (window.location.protocol.startsWith('http')) return `${scheme}://${window.location.host}/realsense`;
+  return 'ws://127.0.0.1:8890';
+}
+
+// ---- Calibration sync with the bridge ----
+// The bridge keeps the calibration in realsense-bridge/calibration.json, where the robot's MCP server
+// reads it. This browser sends its pose (and the arm's "Align 3D" roll offsets) whenever they change,
+// and adopts the bridge's pose when it has none of its own, so a fresh browser never overwrites a
+// good calibration with the default pose.
+let applyingRemotePose = false;
+let syncTimer: ReturnType<typeof setTimeout> | null = null;
+
+function jointOffsets(): Record<string, unknown> {
+  const out: Record<string, unknown> = {};
+  for (let i = 0; i < window.localStorage.length; i++) {
+    const key = window.localStorage.key(i);
+    if (!key?.startsWith(ALIGNMENT_STORAGE_PREFIX)) continue;
+    try {
+      out[key.slice(ALIGNMENT_STORAGE_PREFIX.length)] = JSON.parse(window.localStorage.getItem(key) ?? '{}');
+    } catch {
+      // skip unreadable entries
+    }
+  }
+  return out;
+}
+
+function sendCalibration() {
+  if (!socket || socket.readyState !== WebSocket.OPEN || !status.serial || !hasStoredCameraPose()) return;
+  socket.send(JSON.stringify({
+    type: 'calibration',
+    camera_serial: status.serial,
+    camera_pose: getCameraPose(),
+    joint_offsets: jointOffsets(),
+  }));
+}
+
+function scheduleCalibrationSync() {
+  if (applyingRemotePose) return;
+  if (syncTimer) clearTimeout(syncTimer);
+  syncTimer = setTimeout(() => {
+    syncTimer = null;
+    sendCalibration();
+  }, 400); // slider drags send one update, not hundreds
+}
+
+interface RemoteArmFit {
+  serial?: string;
+  camera_pose?: CameraPose;
+  joint_offsets?: Record<string, number>;
+  joint_spans?: Record<string, number>;
+  updated?: string;
+}
+
+interface RemoteCalibration {
+  camera_pose?: CameraPose;
+  camera_serial?: string;
+  arm_fit?: RemoteArmFit;
+}
+
+const ARM_FIT_ADOPTED_PREFIX = 'realsense.armFitAdopted.';
+
+/**
+ * A depth-camera arm fit made outside the browser (normacore-mcp's arm_fit.py: camera pose, joint
+ * zeros and true joint spans fitted together) replaces this browser's pose and arm alignment once
+ * per fit, so the point cloud lines up with the 3D arm. Later edits in the align panel are kept
+ * until the next fit. Without an arm fit, the bridge's pose is only used when this browser has none.
+ */
+function adoptRemoteCalibration(msg: RemoteCalibration) {
+  if (msg.camera_serial && status.serial && msg.camera_serial !== status.serial) return;
+  const fit = msg.arm_fit;
+  const fitKey = ARM_FIT_ADOPTED_PREFIX + (msg.camera_serial ?? status.serial ?? 'default');
+  const newFit = Boolean(fit?.camera_pose && fit.updated && fit.serial)
+    && window.localStorage.getItem(fitKey) !== fit!.updated;
+  const pose = newFit ? fit!.camera_pose : (hasStoredCameraPose() ? undefined : msg.camera_pose);
+  if (!pose) return;
+  applyingRemotePose = true;
+  try {
+    setCameraPose(pose);
+    if (newFit) {
+      saveJointCalibration(fit!.serial!, fit!.joint_offsets ?? {}, fit!.joint_spans ?? {});
+      window.localStorage.setItem(fitKey, fit!.updated!);
+    }
+  } finally {
+    applyingRemotePose = false;
+  }
+}
+
+function setStatus(next: RealsenseStatus) {
+  status = next;
+  statusListeners.forEach((l) => l());
+}
+
+function scheduleReconnect() {
+  if (retryTimer) return;
+  retryTimer = setTimeout(() => {
+    retryTimer = null;
+    connect();
+  }, retryDelayMs);
+  retryDelayMs = Math.min(retryDelayMs * 2, 5000);
+}
+
+function connect() {
+  let ws: WebSocket;
+  try {
+    ws = new WebSocket(bridgeUrl());
+  } catch {
+    scheduleReconnect();
+    return;
+  }
+  ws.binaryType = 'arraybuffer';
+  socket = ws;
+
+  ws.onopen = () => {
+    retryDelayMs = 1000;
+    setStatus({ ...DISCONNECTED, connected: true, state: 'no_device', message: 'Waiting for camera' });
+  };
+  ws.onmessage = (event) => {
+    if (typeof event.data === 'string') {
+      try {
+        const parsed = JSON.parse(event.data);
+        if (parsed?.type === 'calibration') {
+          adoptRemoteCalibration(parsed);
+          return;
+        }
+      } catch {
+        return;
+      }
+      const msg = parseStatusMessage(event.data);
+      if (!msg) return;
+      if (msg.serial) setActiveCameraSerial(msg.serial);
+      setStatus({
+        connected: true,
+        streaming: msg.state === 'streaming',
+        state: msg.state,
+        message: msg.message ?? '',
+        serial: msg.serial ?? status.serial,
+        firmware: msg.firmware ?? status.firmware,
+        name: msg.name ?? status.name,
+      });
+      scheduleCalibrationSync();
+      return;
+    }
+    let frame: RealsenseFrame;
+    try {
+      frame = parseFrameMessage(event.data as ArrayBuffer);
+    } catch {
+      return; // malformed frame: skip it
+    }
+    latestFrame = frame;
+    frameListeners.forEach((l) => l(frame));
+  };
+  // The bridge is often simply not running: stay quiet and retry.
+  ws.onerror = () => {};
+  ws.onclose = () => {
+    if (socket === ws) socket = null;
+    latestFrame = null;
+    if (status !== DISCONNECTED) setStatus(DISCONNECTED);
+    scheduleReconnect();
+  };
+}
+
+function ensureStarted() {
+  if (started || typeof window === 'undefined') return;
+  started = true;
+  subscribeCameraPose(() => scheduleCalibrationSync());
+  window.addEventListener(ALIGN_EVENT, () => scheduleCalibrationSync());
+  connect();
+}
+
+export function getRealsenseStatus(): RealsenseStatus {
+  return status;
+}
+
+export function getLatestRealsenseFrame(): RealsenseFrame | null {
+  return latestFrame;
+}
+
+/** Subscribe to frames; the listener gets the current frame immediately if there is one. */
+export function subscribeRealsenseFrames(listener: FrameListener): () => void {
+  ensureStarted();
+  frameListeners.add(listener);
+  if (latestFrame) listener(latestFrame);
+  return () => {
+    frameListeners.delete(listener);
+  };
+}
+
+function subscribeStatus(listener: () => void): () => void {
+  ensureStarted();
+  statusListeners.add(listener);
+  return () => {
+    statusListeners.delete(listener);
+  };
+}
+
+export function useRealsenseStatus(): RealsenseStatus {
+  return useSyncExternalStore(subscribeStatus, getRealsenseStatus, getRealsenseStatus);
+}
