+                title="Measure how far the arm's depth points are from the 3D arm right now"
+              >
+                Check
+              </button>
+              {calibration.armSampleCount > 0 && (
+                <button
+                  type="button"
+                  onClick={clearArmSamples}
+                  className="h-8 rounded-md px-2 text-text-muted hover:text-text-primary"
+                >
+                  Clear poses
+                </button>
+              )}
+              <button
+                type="button"
+                onClick={startCalibration}
+                disabled={!status.streaming || !calibration.hasTipProvider}
+                className="h-8 rounded-md bg-signal px-3 font-medium text-[#1a1408] transition-colors hover:bg-signal-deep disabled:cursor-not-allowed disabled:opacity-50"
+              >
+                Calibrate by clicking
+              </button>
+              <button
+                type="button"
+                onClick={() => setCameraPose(DEFAULT_CAMERA_POSE)}
+                className="h-8 rounded-md border border-border-subtle px-3 hover:text-text-primary"
+              >
+                Reset
+              </button>
+            </div>
+            {calibration.levelInfo && <p className="text-text-primary">{calibration.levelInfo}</p>}
+            <label className="flex items-center gap-2">
+              <input
+                type="checkbox"
+                checked={calibration.keepLevel}
+                onChange={(e) => setKeepLevel(e.target.checked)}
+              />
+              Keep level when calibrating (solve only yaw, side, distance)
+            </label>
+            <p className="text-text-muted">
+              Distance is measured from the robot base toward the front of the arm. Nudge until the table and
+              the gripper in the points line up with the 3D arm.
+            </p>
+          </div>
+        )}
+      </div>
+    </div>
+  );
+}
+
+export default RealsenseAlignPanel;
diff --git a/software/station/clients/station-viewer/src/realsense/RealsenseFeed.tsx b/software/station/clients/station-viewer/src/realsense/RealsenseFeed.tsx
