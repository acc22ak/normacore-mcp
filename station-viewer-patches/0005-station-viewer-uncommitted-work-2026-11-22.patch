+import { describe, expect, it } from 'vitest';
+import { drivers, usbvideo } from '@/api/proto.js';
+import type { FrameEntry } from '@/api/frame-parser';
+import { connectedCameras } from './camera-presence';
+
+const camera = (queueId: string, type: usbvideo.RxEnvelopeType): FrameEntry<usbvideo.IRxEnvelope> => ({
+  queueId,
+  ptr: new Uint8Array(),
+  data: { type },
+  queueType: drivers.QueueDataType.QDT_USB_VIDEO_FRAMES,
+});
+
+describe('connectedCameras', () => {
+  // The home page showed three "Waiting for USB Video data..." tiles for cameras that had been
+  // unplugged for hours, instead of the "No devices connected" panel.
+  it('leaves out cameras whose last event says they were unplugged', () => {
+    const sources = [
+      camera('live', usbvideo.RxEnvelopeType.ET_FRAMES),
+      camera('starting', usbvideo.RxEnvelopeType.ET_DEVICE_CONNECTED),
+      camera('ended', usbvideo.RxEnvelopeType.ET_DEVICE_RECORDING_END),
+      camera('unplugged', usbvideo.RxEnvelopeType.ET_DEVICE_DISCONNECTED),
+    ];
+    expect(connectedCameras(sources).map((s) => s.queueId)).toEqual(['live', 'starting']);
+  });
+
+  it('gives an empty list when every camera is gone, so the page can show its standby panel', () => {
+    expect(connectedCameras([camera('a', usbvideo.RxEnvelopeType.ET_DEVICE_RECORDING_END)])).toEqual([]);
+    expect(connectedCameras(undefined)).toEqual([]);
+  });
+});
diff --git a/software/station/clients/station-viewer/src/usbvideo/camera-presence.ts b/software/station/clients/station-viewer/src/usbvideo/camera-presence.ts
