@@ -0,0 +1,45 @@
+import { describe, expect, it } from 'vitest';
+import { parseFrameMessage, sampleDepthMm } from './protocol';
+
+function buildMessage(depthValues: number[], w: number, h: number, jpeg = [0xff, 0xd8, 0xff]): ArrayBuffer {
+  const depthBytes = new Uint8Array(new Uint16Array(depthValues).buffer);
+  const header = new TextEncoder().encode(JSON.stringify({
+    type: 'frame', seq: 7, ts: 1, serial: 'x',
+    color: { w: 640, h: 480, bytes: jpeg.length },
+    depth: { w, h, bytes: depthBytes.length, unit_m: 0.001 },
+    intrinsics: { fx: 300, fy: 300, ppx: 1, ppy: 1 },
+  }));
+  const out = new Uint8Array(4 + header.length + jpeg.length + depthBytes.length);
+  new DataView(out.buffer).setUint32(0, header.length, true);
+  out.set(header, 4);
+  out.set(jpeg, 4 + header.length);
+  out.set(depthBytes, 4 + header.length + jpeg.length);
+  return out.buffer;
+}
+
+describe('parseFrameMessage', () => {
+  it('slices jpeg and depth at the offsets the header declares, even when unaligned', () => {
+    // 3-byte jpeg makes the depth start at an odd offset for most header lengths.
+    const frame = parseFrameMessage(buildMessage([1, 2, 3, 400], 2, 2));
+    expect(Array.from(frame.jpeg)).toEqual([0xff, 0xd8, 0xff]);
+    expect(Array.from(frame.depth)).toEqual([1, 2, 3, 400]);
+    expect(frame.header.seq).toBe(7);
+  });
+
+  it('rejects a truncated message instead of reading garbage', () => {
+    const buf = buildMessage([1, 2, 3, 4], 2, 2);
+    expect(() => parseFrameMessage(buf.slice(0, buf.byteLength - 1))).toThrow();
+  });
+});
+
+describe('sampleDepthMm', () => {
+  it('ignores holes (zeros) and returns the median of valid depth', () => {
+    const frame = parseFrameMessage(buildMessage([0, 500, 0, 510, 900, 0, 0, 505, 0], 3, 3));
+    expect(sampleDepthMm(frame, 1, 1, 1)).toBe(510);
+  });
+
+  it('returns null when the window has no depth', () => {
+    const frame = parseFrameMessage(buildMessage([0, 0, 0, 0], 2, 2));
+    expect(sampleDepthMm(frame, 0, 0)).toBeNull();
+  });
+});
