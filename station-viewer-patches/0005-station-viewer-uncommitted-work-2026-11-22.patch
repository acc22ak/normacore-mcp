@@ -0,0 +1,84 @@
+/**
+ * Per-arm angle offsets for roll joints, so the 3D model matches the real arm.
+ *
+ * Roll joints often have no real end stops, so auto calibration finds a range that
+ * doesn't line up with the URDF limits and the model is drawn twisted. The user puts
+ * the real arm straight and presses "Align 3D"; each roll joint then gets an offset
+ * that makes its drawn angle zero in that pose. Stored per bus serial in localStorage.
+ */
+
+export type JointOffsets = Record<string, number>;
+
+/** localStorage key prefix; the key is this + bus serial. Also read by the RealSense bridge sync. */
+export const ALIGNMENT_STORAGE_PREFIX = 'st3215-joint-alignment:';
+const STORAGE_PREFIX = ALIGNMENT_STORAGE_PREFIX;
+export const ALIGN_EVENT = 'st3215-joint-alignment-changed';
+/** Ask renderers showing this bus to align to their current pose. detail: { serial } */
+export const ALIGN_REQUEST_EVENT = 'st3215-joint-alignment-request';
+
+function key(serial: string): string {
+  return `${STORAGE_PREFIX}${serial}`;
+}
+
+/**
+ * True rotation (rad) of each joint's calibrated servo range, by joint name. Without it a joint's
+ * 0..1 position is stretched over the URDF limits, which draws angles 2-5% too small on the ElRobot
+ * (shoulder: 193.5 deg real, 184.7 in the URDF). Comes from the depth-camera arm fit (arm_fit.py).
+ */
+export type JointSpans = Record<string, number>;
+const SPAN_STORAGE_PREFIX = 'st3215-joint-spans:';
+
+/**
+ * Joint angle for a normalized position. Must stay identical to normacore-mcp's
+ * arm_model.ArmModel.joint_values, or the depth points and pick/place disagree with this view.
+ */
+export function mapJointAngle(position: number, lower: number, upper: number, span?: number, offset = 0): number {
+  if (span) return (lower + upper) / 2 + (position - 0.5) * span + offset;
+  return lower + position * (upper - lower) + offset;
+}
+
+export function loadJointSpans(serial: string | null | undefined): JointSpans {
+  if (!serial) return {};
+  try {
+    const raw = window.localStorage.getItem(SPAN_STORAGE_PREFIX + serial);
+    const parsed = raw ? JSON.parse(raw) : {};
+    return parsed && typeof parsed === 'object' ? parsed as JointSpans : {};
+  } catch {
+    return {};
+  }
+}
+
+/** Store a whole arm calibration (zero offsets + true joint spans) and redraw the arm. */
+export function saveJointCalibration(serial: string, offsets: JointOffsets, spans: JointSpans): void {
+  window.localStorage.setItem(SPAN_STORAGE_PREFIX + serial, JSON.stringify(spans));
+  saveJointOffsets(serial, offsets);
+}
+
+export function loadJointOffsets(serial: string | null | undefined): JointOffsets {
+  if (!serial) return {};
+  try {
+    const raw = window.localStorage.getItem(key(serial));
+    const parsed = raw ? JSON.parse(raw) : {};
+    return parsed && typeof parsed === 'object' ? parsed as JointOffsets : {};
+  } catch {
+    return {};
+  }
+}
+
+export function saveJointOffsets(serial: string, offsets: JointOffsets): void {
+  window.localStorage.setItem(key(serial), JSON.stringify(offsets));
+  window.dispatchEvent(new CustomEvent(ALIGN_EVENT, { detail: { serial } }));
+}
+
+export function clearJointOffsets(serial: string): void {
+  window.localStorage.removeItem(key(serial));
+  window.dispatchEvent(new CustomEvent(ALIGN_EVENT, { detail: { serial } }));
+}
+
+export function hasJointOffsets(serial: string | null | undefined): boolean {
+  return Object.keys(loadJointOffsets(serial)).length > 0;
+}
+
+export function requestAlignment(serial: string): void {
+  window.dispatchEvent(new CustomEvent(ALIGN_REQUEST_EVENT, { detail: { serial } }));
+}
