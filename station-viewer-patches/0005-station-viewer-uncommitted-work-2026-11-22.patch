diff --git a/software/station/clients/station-viewer/src/agent/AgentActivityPanel.tsx b/software/station/clients/station-viewer/src/agent/AgentActivityPanel.tsx
new file mode 100644
index 0000000..8b8d0f1
--- /dev/null
+++ b/software/station/clients/station-viewer/src/agent/AgentActivityPanel.tsx
@@ -0,0 +1,196 @@
+import { memo, useEffect, useState } from 'react';
+import { createPortal } from 'react-dom';
+
+// Bottom-right panel that shows which agent drives the robot through MCP and the tool calls it is
+// making, live. The feed is Server-Sent Events from the normacore MCP server (GET /events on its HTTP
+// port, normacore-mcp/activity.py). Display only: the panel hides while that server is unreachable.
+
+const MCP_EVENTS_PORT = 8790;
+const VISIBLE_CALLS = 6;
+/** The agent counts as active while its last call is this recent. */
+const ACTIVE_WINDOW_MS = 120_000;
+/** The server sends something at least every 15 s; silence this long means a dead connection. */
+const STALE_MS = 40_000;
+const RECONNECT_MS = 2_000;
+
+interface AgentInfo {
+  label: string;
+  client: string | null;
+  version: string | null;
+}
+
+interface ToolCall {
+  id: number;
+  tool: string;
+  args: string;
+  started: number; // unix seconds
+  status: 'running' | 'ok' | 'failed';
+  ms: number | null;
+}
+
+type AgentEvent =
+  | { type: 'snapshot'; agent: AgentInfo; calls: ToolCall[] }
+  | ({ type: 'agent' } & AgentInfo)
+  | ({ type: 'call' } & ToolCall)
+  | { type: 'ping' }
+  | { type: 'clear' };
+
+function eventsUrl(): string {
+  return `${window.location.protocol}//${window.location.hostname}:${MCP_EVENTS_PORT}/events`;
+}
+
+/** Empties the list on the server, so every open viewer and later reloads start clean too. */
+function clearCalls(): void {
+  fetch(`${eventsUrl()}/clear`, { method: 'POST' }).catch((err) => console.error('Failed to clear agent calls:', err));
+}
+
+function useAgentActivity() {
+  const [connected, setConnected] = useState(false);
+  const [agent, setAgent] = useState<AgentInfo | null>(null);
+  const [calls, setCalls] = useState<ToolCall[]>([]);
+
+  useEffect(() => {
+    // EventSource's own retry can give up (or sit on a dead socket) when the MCP server restarts, which left
+    // the panel showing an old list. So reconnect ourselves: on error, and when the heartbeat stops.
+    let source: EventSource | null = null;
+    let lastMessage = Date.now();
+    let reconnectTimer: ReturnType<typeof setTimeout> | null = null;
+    let disposed = false;
+
+    const scheduleReconnect = () => {
+      source?.close();
+      source = null;
+      setConnected(false);
+      if (!disposed && !reconnectTimer) {
+        reconnectTimer = setTimeout(() => {
+          reconnectTimer = null;
+          connect();
+        }, RECONNECT_MS);
+      }
+    };
+
+    const onMessage = (message: MessageEvent) => {
+      lastMessage = Date.now();
+      let event: AgentEvent;
+      try {
+        event = JSON.parse(message.data) as AgentEvent;
+      } catch {
+        return;
+      }
+      if (event.type === 'snapshot') {
+        setAgent(event.agent);
+        setCalls(event.calls.slice(-VISIBLE_CALLS));
+      } else if (event.type === 'clear') {
+        setCalls([]);
+      } else if (event.type === 'agent') {
+        setAgent({ label: event.label, client: event.client, version: event.version });
+      } else if (event.type === 'call') {
+        const { type: _type, ...call } = event;
+        setCalls((prev) => {
+          const rest = prev.filter((c) => c.id !== call.id);
+          return [...rest, call].sort((a, b) => a.id - b.id).slice(-VISIBLE_CALLS);
+        });
+      }
+    };
+
+    function connect() {
+      if (disposed) return;
+      lastMessage = Date.now();
+      source = new EventSource(eventsUrl());
+      source.onopen = () => setConnected(true);
+      source.onerror = scheduleReconnect;
+      source.onmessage = onMessage;
+    }
+
+    connect();
+    const watchdog = setInterval(() => {
+      if (source && Date.now() - lastMessage > STALE_MS) scheduleReconnect();
+    }, 5_000);
+    return () => {
+      disposed = true;
+      clearInterval(watchdog);
+      if (reconnectTimer) clearTimeout(reconnectTimer);
+      source?.close();
+    };
+  }, []);
+
+  return { connected, agent, calls };
+}
+
+/** The element shown fullscreen (e.g. the 3D view), else null: the panel has to live inside it to be seen. */
+function useFullscreenElement(): Element | null {
+  const [element, setElement] = useState<Element | null>(() => document.fullscreenElement);
+  useEffect(() => {
+    const update = () => setElement(document.fullscreenElement);
+    document.addEventListener('fullscreenchange', update);
+    return () => document.removeEventListener('fullscreenchange', update);
+  }, []);
+  return element;
+}
+
+function formatDuration(ms: number): string {
+  return ms < 1000 ? `${ms} ms` : `${(ms / 1000).toFixed(1)} s`;
+}
+
+const AgentActivityPanel = memo(function AgentActivityPanel() {
+  const { connected, agent, calls } = useAgentActivity();
+  const fullscreenElement = useFullscreenElement();
+  const [now, setNow] = useState(() => Date.now());
+
+  useEffect(() => {
+    const timer = setInterval(() => setNow(Date.now()), 1000);
+    return () => clearInterval(timer);
+  }, []);
+
+  if (!connected || !agent) return null;
+
+  const last = calls[calls.length - 1];
+  const active = Boolean(last && (last.status === 'running' || now - last.started * 1000 < ACTIVE_WINDOW_MS));
+  const client = agent.client ? `${agent.client}${agent.version ? ` ${agent.version}` : ''}` : 'waiting for a client';
+
+  return createPortal(
+    <div className="pointer-events-none fixed bottom-4 right-4 z-40 w-[300px] rounded-lg border border-border-default bg-surface-base/60 text-[11px] backdrop-blur-[3px]">
+      <div className="flex items-center gap-2 px-3 pt-2.5">
+        <span
+          className={`h-1.5 w-1.5 shrink-0 rounded-full ${active ? 'bg-accent-success' : 'bg-text-muted'}`}
+          aria-hidden
+        />
+        <span className="truncate text-[12px] font-medium text-text-primary">{agent.label}</span>
+        {calls.length > 0 && (
+          <button
+            type="button"
+            onClick={clearCalls}
+            className="pointer-events-auto ml-auto text-text-muted transition-colors hover:text-text-primary"
+          >
+            Clear
+          </button>
+        )}
+      </div>
+      <div className="truncate px-3 pb-2 pl-[1.6rem] text-text-muted">via MCP · {client}</div>
+      {calls.length > 0 && (
+        <ul className="border-t border-border-default/60 px-3 py-1.5 font-mono">
+          {calls.map((call) => (
+            <li key={call.id} className="flex items-baseline gap-2 py-0.5">
+              <span className="shrink-0 text-text-primary">{call.tool}</span>
+              <span className="min-w-0 flex-1 truncate text-text-muted">
+                {call.args}
+              </span>
+              <span className="w-12 shrink-0 text-right tabular-nums">
+                {call.status === 'running' ? (
+                  <span className="inline-block h-1.5 w-1.5 animate-pulse rounded-full bg-accent-warning" aria-label="running" />
+                ) : call.status === 'ok' ? (
+                  <span className="text-text-secondary">{formatDuration(call.ms ?? 0)}</span>
+                ) : (
+                  <span className="text-accent-critical">failed</span>
+                )}
+              </span>
+            </li>
+          ))}
+        </ul>
+      )}
+    </div>,
+    fullscreenElement ?? document.body,
+  );
+});
+
+export default AgentActivityPanel;
