@@ -0,0 +1,52 @@
+import * as THREE from 'three';
+import { describe, expect, it } from 'vitest';
+import { applyPoseToObject, type CameraPose } from './camera-pose';
+import { fitArmShape } from './arm-icp';
+
+// ICP that converges to a wrong local minimum or drifts would silently misplace the cloud by a
+// few centimetres, exactly the error this step is meant to remove.
+
+function armModel(): THREE.Vector3[] {
+  // An L-shaped "arm" (vertical post + horizontal boom + a box "gripper"), randomly sampled on
+  // its surfaces. Random, not regular, sampling: a regular pattern can match itself when shifted.
+  let s = 9;
+  const rnd = () => (s = (s * 16807) % 2147483647) / 2147483647;
+  const pts: THREE.Vector3[] = [];
+  for (let i = 0; i < 700; i++) {
+    const a = rnd() * Math.PI * 2;
+    pts.push(new THREE.Vector3(0.03 * Math.cos(a), rnd() * 0.25, 0.03 * Math.sin(a)));
+    const b = rnd() * Math.PI * 2;
+    pts.push(new THREE.Vector3(rnd() * 0.3, 0.25 + 0.025 * Math.cos(b), 0.06 + 0.025 * Math.sin(b)));
+  }
+  for (let i = 0; i < 300; i++) {
+    const face = Math.floor(rnd() * 3);
+    const u = rnd() * 0.06 - 0.03;
+    const v = rnd() * 0.06 - 0.03;
+    const p = face === 0 ? [0.03, u, v] : face === 1 ? [u, 0.03, v] : [u, v, 0.03];
+    pts.push(new THREE.Vector3(0.33 + p[0], 0.22 + p[1], 0.06 + p[2]));
+  }
+  return pts;
+}
+
+function toCamera(world: THREE.Vector3[], pose: CameraPose): THREE.Vector3[] {
+  const o = new THREE.Object3D();
+  applyPoseToObject(pose, o);
+  o.updateMatrix();
+  const inv = o.matrix.clone().invert();
+  return world.map((p) => p.clone().applyMatrix4(inv));
+}
+
+describe('fitArmShape', () => {
+  it('pulls a few-cm, few-degree misalignment back onto the arm', () => {
+    const truth: CameraPose = { x: 0.85, y: 0.45, z: 0.05, yaw: 1.7, pitch: -0.49, roll: 0.01 };
+    const model = armModel();
+    // The camera sees only part of the surface.
+    const seen = toCamera(model.filter((_, i) => i % 3 !== 0), truth);
+    const start = { ...truth, x: truth.x + 0.035, z: truth.z - 0.025, yaw: truth.yaw + 0.05 };
+
+    const result = fitArmShape([{ cameraPoints: seen, modelPoints: model }], start);
+
+    expect(Math.hypot(result.pose.x - truth.x, result.pose.z - truth.z)).toBeLessThan(0.003);
+    expect(Math.abs(result.pose.yaw - truth.yaw)).toBeLessThan(0.01);
+  });
+});
diff --git a/software/station/clients/station-viewer/src/realsense/arm-icp.ts b/software/station/clients/station-viewer/src/realsense/arm-icp.ts
new file mode 100644
index 0000000..82b8334
--- /dev/null
+++ b/software/station/clients/station-viewer/src/realsense/arm-icp.ts
@@ -0,0 +1,189 @@
+import * as THREE from 'three';
+import { applyPoseToObject, deprojectToLocal, type CameraPose } from './camera-pose';
+import type { RealsenseFrame } from './protocol';
+import { fitYawAndPosition } from './rigid-fit';
+
+// "Fit to arm shape": iterative closest point between the depth points of the real arm and the
+// surface of the 3D arm model. Pitch, roll and height stay fixed (from the table plane); each
+// iteration matches every depth point to its nearest model point and re-solves yaw + side/distance.
+// Uses thousands of visible surface points, so no clicking and no surface-vs-centre offset.
+
+export interface IcpResult {
+  pose: CameraPose;
+  /** RMS distance of matched depth points to the model, metres. */
+  rms: number;
+  matched: number;
+  iterations: number;
+}
+
+export const ErrTooFewArmPoints = new Error('too few depth points near the 3D arm; is the arm in view and roughly aligned?');
+
+const CELL_M = 0.02;
+
+class PointGrid {
+  private cells = new Map<string, THREE.Vector3[]>();
+
+  constructor(points: THREE.Vector3[]) {
+    for (const p of points) {
+      const key = this.key(Math.floor(p.x / CELL_M), Math.floor(p.y / CELL_M), Math.floor(p.z / CELL_M));
+      const cell = this.cells.get(key);
+      if (cell) cell.push(p);
+      else this.cells.set(key, [p]);
+    }
+  }
+
+  private key(i: number, j: number, k: number): string {
+    return `${i},${j},${k}`;
+  }
+
+  /** Nearest point within `maxDist` (≤ 2 cells), or null. */
+  nearest(p: THREE.Vector3, maxDist: number): THREE.Vector3 | null {
+    const r = Math.ceil(maxDist / CELL_M);
+    const ci = Math.floor(p.x / CELL_M);
+    const cj = Math.floor(p.y / CELL_M);
+    const ck = Math.floor(p.z / CELL_M);
+    let best: THREE.Vector3 | null = null;
+    let bestD2 = maxDist * maxDist;
+    for (let i = ci - r; i <= ci + r; i++) {
+      for (let j = cj - r; j <= cj + r; j++) {
+        for (let k = ck - r; k <= ck + r; k++) {
+          const cell = this.cells.get(this.key(i, j, k));
+          if (!cell) continue;
+          for (const q of cell) {
+            const d2 = p.distanceToSquared(q);
+            if (d2 < bestD2) {
+              bestD2 = d2;
+              best = q;
+            }
+          }
+        }
+      }
+    }
+    return best;
+  }
+}
+
+function worldTransform(pose: CameraPose): THREE.Matrix4 {
+  const o = new THREE.Object3D();
+  applyPoseToObject(pose, o);
+  o.updateMatrix();
+  return o.matrix;
+}
+
+/** One arm pose: depth points of the arm (camera rig frame) and the 3D arm's surface (world). */
+export interface ArmSample {
+  cameraPoints: THREE.Vector3[];
+  modelPoints: THREE.Vector3[];
+}
+
+interface PreparedSample {
+  cameraPoints: THREE.Vector3[];
+  grid: PointGrid;
+}
+
+/** Points used per pose: more adds little accuracy but makes the (main-thread) fit slow. */
+const MAX_POINTS_PER_SAMPLE = 600;
+
+function prepare(samples: ArmSample[]): PreparedSample[] {
+  return samples.map((s) => {
+    const stride = Math.max(1, Math.ceil(s.cameraPoints.length / MAX_POINTS_PER_SAMPLE));
+    const cameraPoints = stride === 1 ? s.cameraPoints : s.cameraPoints.filter((_, i) => i % stride === 0);
+    return { cameraPoints, grid: new PointGrid(s.modelPoints) };
+  });
+}
+
+function matchAll(prepared: PreparedSample[], pose: CameraPose, maxDist: number) {
+  const m = worldTransform(pose);
+  const from: THREE.Vector3[] = [];
+  const to: THREE.Vector3[] = [];
+  const dists: number[] = [];
+  const w = new THREE.Vector3();
+  for (const sample of prepared) {
+    for (const c of sample.cameraPoints) {
+      w.copy(c).applyMatrix4(m);
+      const q = sample.grid.nearest(w, maxDist);
+      if (!q) continue;
+      from.push(c);
+      to.push(q);
+      dists.push(w.distanceTo(q));
+    }
+  }
+  return { from, to, dists };
+}
+
+/** RMS distance (metres) of the arm's depth points to the model at `pose`, without fitting. */
+export function armShapeError(samples: ArmSample[], pose: CameraPose, maxDist = 0.03): { rms: number; matched: number } {
+  const { dists } = matchAll(prepare(samples), pose, maxDist);
+  if (dists.length === 0) return { rms: Infinity, matched: 0 };
+  return { rms: Math.sqrt(dists.reduce((a, d) => a + d * d, 0) / dists.length), matched: dists.length };
+}
+
+/**
+ * Refine yaw and horizontal position so every sample's depth points lie on its model surface.
+ * Pitch, roll and y of `start` are kept. Fitting several arm poses together removes the sliding
+ * ambiguity a single long, thin arm has.
+ */
+export function fitArmShape(
+  samples: ArmSample[],
+  start: CameraPose,
+  { iterations = 60, startMatchM = 0.08, endMatchM = 0.012 } = {},
+): IcpResult {
+  const prepared = prepare(samples);
+  let pose = start;
+  let rms = Infinity;
+  let matched = 0;
+  let it = 0;
+  for (; it < iterations; it++) {
+    // Shrink the match radius so far-off outliers stop pulling once we're close.
+    const t = iterations > 1 ? it / (iterations - 1) : 1;
+    const maxDist = startMatchM * Math.pow(endMatchM / startMatchM, t);
+    const { from, to, dists } = matchAll(prepared, pose, maxDist);
+    if (from.length < 30) throw ErrTooFewArmPoints;
+    // Trim the worst 10%: occlusions and parts the model doesn't have (cables, clamps). Trimming
+    // harder lets one part of the arm (e.g. the forearm) win and the fit slide along it.
+    const sorted = [...dists].sort((a, b) => a - b);
+    const cut = sorted[Math.floor(sorted.length * 0.9)];
+    const keepFrom: THREE.Vector3[] = [];
+    const keepTo: THREE.Vector3[] = [];
+    for (let i = 0; i < from.length; i++) {
+      if (dists[i] <= cut) {
+        keepFrom.push(from[i]);
+        keepTo.push(to[i]);
+      }
+    }
+    const fit = fitYawAndPosition(keepFrom, keepTo, pose.pitch, pose.roll, pose.y);
+    pose = { ...pose, yaw: fit.yaw, x: fit.translation.x, z: fit.translation.z };
+    rms = fit.rms;
+    matched = keepFrom.length;
+  }
+  return { pose, rms, matched, iterations: it };
+}
+
+/**
+ * Depth points that belong to the arm: above the table (world y > `minHeightM`) and within
+ * `nearM` of the model, in the camera rig frame. Uses the current pose to decide.
+ */
+export function armCandidatePoints(
+  frame: RealsenseFrame,
+  pose: CameraPose,
+  modelPoints: THREE.Vector3[],
+  { stride = 2, minHeightM = 0.012, nearM = 0.12 } = {},
+): THREE.Vector3[] {
+  const grid = new PointGrid(modelPoints);
+  const m = worldTransform(pose);
+  const { w, h, unit_m } = frame.header.depth;
+  const out: THREE.Vector3[] = [];
+  const world = new THREE.Vector3();
+  for (let v = 0; v < h; v += stride) {
+    for (let u = 0; u < w; u += stride) {
+      const d = frame.depth[v * w + u];
+      if (d === 0) continue;
+      const c = deprojectToLocal(u, v, d * unit_m, frame.header.intrinsics);
+      world.copy(c).applyMatrix4(m);
+      if (world.y < minHeightM) continue;
+      if (!grid.nearest(world, nearM)) continue;
+      out.push(c);
+    }
+  }
+  return out;
+}
diff --git a/software/station/clients/station-viewer/src/realsense/calibration-store.ts b/software/station/clients/station-viewer/src/realsense/calibration-store.ts
