@@ -0,0 +1,64 @@
+import { memo } from 'react';
+
+const CHECKS = [
+  { title: 'Servo bus board', detail: 'Jumper set to B, data USB-C cable into the hub.' },
+  { title: 'Arm power', detail: 'Leader on the 5 V brick, follower on the 12 V brick.' },
+  { title: 'Cameras', detail: 'Plugged into a powered USB hub, not straight into the laptop.' },
+];
+
+// A follower arm at rest, drawn with the same outline language as the 3D view.
+function RestingArm() {
+  return (
+    <svg
+      viewBox="0 0 220 160"
+      className="h-auto w-[220px] text-text-dim"
+      fill="none"
+      stroke="currentColor"
+      strokeWidth="1.5"
+      strokeLinecap="round"
+      strokeLinejoin="round"
+      aria-hidden
+    >
+      <line x1="10" y1="148" x2="210" y2="148" strokeDasharray="2 5" />
+      <rect x="34" y="128" width="52" height="20" rx="3" />
+      <rect x="48" y="112" width="24" height="16" rx="2" />
+      <circle cx="60" cy="104" r="9" />
+      <path d="M66 97 L118 52" strokeWidth="10" className="text-surface-elevated" />
+      <path d="M66 97 L118 52" />
+      <circle cx="122" cy="48" r="8" />
+      <path d="M129 52 L166 88" strokeWidth="8" className="text-surface-elevated" />
+      <path d="M129 52 L166 88" />
+      <circle cx="170" cy="92" r="6" />
+      <path d="M172 98 L168 116 M176 97 L184 113" />
+      <circle cx="60" cy="104" r="2.5" className="text-signal" fill="currentColor" stroke="none" />
+    </svg>
+  );
+}
+
+function StandbyPanelComponent() {
+  return (
+    <section className="flex w-full max-w-[40rem] flex-col gap-7 sm:flex-row sm:items-center sm:gap-10">
+      <RestingArm />
+      <div className="flex flex-col gap-4">
+        <div>
+          <h1 className="text-[22px] font-semibold leading-tight text-text-primary">No devices connected</h1>
+          <p className="mt-1.5 max-w-[46ch] text-text-label">
+            The station looks for USB devices every second. Arms, cameras and sensors show up here as soon as they're plugged in.
+          </p>
+        </div>
+        <dl className="flex flex-col gap-2.5 border-l border-border-subtle pl-4">
+          {CHECKS.map((check) => (
+            <div key={check.title}>
+              <dt className="font-medium text-text-secondary">{check.title}</dt>
+              <dd className="text-[13px] text-text-muted">{check.detail}</dd>
+            </div>
+          ))}
+        </dl>
+      </div>
+    </section>
+  );
+}
+
+const StandbyPanel = memo(StandbyPanelComponent);
+StandbyPanel.displayName = 'StandbyPanel';
+export default StandbyPanel;
