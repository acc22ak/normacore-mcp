+import { describe, expect, it } from 'vitest';
+import * as THREE from 'three';
+import { dragBall, furthestAllowed, penetration, type DragAnchor, type KeepOut } from './grab-ball';
+
+const rayThrough = (from: THREE.Vector3, to: THREE.Vector3) =>
+  new THREE.Ray(from.clone(), to.clone().sub(from).normalize());
+
+describe('dragBall', () => {
+  const camera = new THREE.Vector3(0.5, 0.6, 0.8);
+  const cameraDirection = new THREE.Vector3(-0.5, -0.5, -0.8).normalize();
+
+  it('a plain drag slides the ball sideways and never changes its height', () => {
+    const ball = new THREE.Vector3(0.3, 0.12, 0);
+    const anchor: DragAnchor = { hit: null, lift: false };
+    dragBall(rayThrough(camera, ball), ball, false, cameraDirection, anchor);
+    const next = dragBall(rayThrough(camera, new THREE.Vector3(0.32, 0.12, 0.03)), ball, false, cameraDirection, anchor);
+    expect(next.y).toBe(0.12);
+    expect(next.x).toBeCloseTo(0.32, 3);
+    expect(next.z).toBeCloseTo(0.03, 3);
+  });
+
+  it('a Shift drag moves the ball only up and down', () => {
+    const ball = new THREE.Vector3(0.3, 0.12, 0);
+    const anchor: DragAnchor = { hit: null, lift: true };
+    dragBall(rayThrough(camera, ball), ball, true, cameraDirection, anchor);
+    const next = dragBall(rayThrough(camera, new THREE.Vector3(0.3, 0.17, 0)), ball, true, cameraDirection, anchor);
+    expect(next.x).toBe(0.3);
+    expect(next.z).toBe(0);
+    expect(next.y).toBeCloseTo(0.17, 3);
+  });
+
+  it('pressing Shift in the middle of a drag does not make the ball jump', () => {
+    const ball = new THREE.Vector3(0.3, 0.12, 0);
+    const anchor: DragAnchor = { hit: null, lift: false };
+    dragBall(rayThrough(camera, ball), ball, false, cameraDirection, anchor);
+    // Same pointer position, Shift now held: the horizontal-plane anchor must not be reused.
+    const next = dragBall(rayThrough(camera, new THREE.Vector3(0.3, 0.2, 0.1)), ball, true, cameraDirection, anchor);
+    expect(next.distanceTo(ball)).toBe(0);
+  });
+});
+
+describe('keep-out space', () => {
+  const keepOut: KeepOut = { tableY: 0, backX: -0.12, margin: 0.008 };
+
+  it('reports how deep the arm is in the table or behind the back limit', () => {
+    expect(penetration(0.05, 0.1, keepOut)).toBe(0);
+    expect(penetration(0.002, 0.1, keepOut)).toBeCloseTo(0.006);
+    expect(penetration(0.05, -0.15, keepOut)).toBeCloseTo(0.038);
+    expect(penetration(0.05, -5, { ...keepOut, backX: null })).toBe(0);
+  });
+
+  it('stops a drag at the table instead of passing through it', () => {
+    // Stand-in for the arm: its lowest point is 4 cm under the ball.
+    const evaluate = (p: THREE.Vector3) => ({ penetration: penetration(p.y - 0.04, 0.2, keepOut), value: p.y });
+    const from = new THREE.Vector3(0.3, 0.1, 0);
+    const result = furthestAllowed(from, new THREE.Vector3(0.3, 0.0, 0), evaluate, 0, 6);
+    expect(result.blocked).toBe(true);
+    expect(result.position.y).toBeGreaterThanOrEqual(0.048);
+    expect(result.position.y).toBeLessThan(0.052);
+    expect(result.value).toBeCloseTo(result.position.y);
+  });
+
+  it('lets an arm that starts inside the keep-out space move out, but not further in', () => {
+    const evaluate = (p: THREE.Vector3) => ({ penetration: penetration(0.05, p.x, keepOut), value: p.x });
+    const start = new THREE.Vector3(-0.15, 0.1, 0);
+    const startPenetration = penetration(0.05, start.x, keepOut);
+    expect(furthestAllowed(start, new THREE.Vector3(0, 0.1, 0), evaluate, startPenetration).blocked).toBe(false);
+    const deeper = furthestAllowed(start, new THREE.Vector3(-0.3, 0.1, 0), evaluate, startPenetration);
+    expect(deeper.blocked).toBe(true);
+    expect(deeper.position.x).toBeCloseTo(-0.15, 2);
+  });
+});
