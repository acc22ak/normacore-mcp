diff --git a/software/station/clients/station-viewer/src/st3215/RotationDial.tsx b/software/station/clients/station-viewer/src/st3215/RotationDial.tsx
new file mode 100644
index 0000000..9b8888e
--- /dev/null
+++ b/software/station/clients/station-viewer/src/st3215/RotationDial.tsx
@@ -0,0 +1,61 @@
+import React from 'react';
+import { MAX_ANGLE_STEP } from './motor-parser';
+
+interface RotationDialProps {
+  position: number;
+  rangeMin: number;
+  rangeMax: number;
+  isFallbackRange?: boolean;
+  hasError?: boolean;
+  size?: number;
+}
+
+const STEPS_PER_TURN = MAX_ANGLE_STEP + 1;
+
+const toPoint = (step: number, radius: number, center: number) => {
+  const angle = (step / STEPS_PER_TURN) * 2 * Math.PI - Math.PI / 2;
+  return { x: center + radius * Math.cos(angle), y: center + radius * Math.sin(angle) };
+};
+
+const describeArc = (fromStep: number, toStep: number, radius: number, center: number) => {
+  const sweep = (((toStep - fromStep) % STEPS_PER_TURN) + STEPS_PER_TURN) % STEPS_PER_TURN;
+  const start = toPoint(fromStep, radius, center);
+  const end = toPoint(fromStep + sweep, radius, center);
+  const largeArc = sweep > STEPS_PER_TURN / 2 ? 1 : 0;
+  return `M ${start.x} ${start.y} A ${radius} ${radius} 0 ${largeArc} 1 ${end.x} ${end.y}`;
+};
+
+const RotationDial: React.FC<RotationDialProps> = ({
+  position,
+  rangeMin,
+  rangeMax,
+  isFallbackRange = false,
+  hasError = false,
+  size = 22,
+}) => {
+  const center = size / 2;
+  const radius = center - 1.5;
+  const needle = toPoint(position, radius - 1, center);
+  const degrees = Math.round((position / STEPS_PER_TURN) * 360);
+
+  return (
+    <svg
+      width={size}
+      height={size}
+      viewBox={`0 0 ${size} ${size}`}
+      className={hasError ? 'text-accent-critical' : 'text-text-primary'}
+      role="img"
+      aria-label={`${degrees}°`}
+    >
+      <title>{`${degrees}° · range ${rangeMin}–${rangeMax}`}</title>
+      <circle cx={center} cy={center} r={radius} fill="none" stroke="currentColor" strokeOpacity={0.12} strokeWidth={1} />
+      {!isFallbackRange && (
+        <path d={describeArc(rangeMin, rangeMax, radius, center)} fill="none" stroke="currentColor" strokeOpacity={0.45} strokeWidth={1.5} />
+      )}
+      <line x1={center} y1={center} x2={needle.x} y2={needle.y} stroke="currentColor" strokeWidth={1.25} strokeLinecap="round" />
+      <circle cx={center} cy={center} r={1.25} fill="currentColor" />
+    </svg>
+  );
+};
+
+export default RotationDial;
