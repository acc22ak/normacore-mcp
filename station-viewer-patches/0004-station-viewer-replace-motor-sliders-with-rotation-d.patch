@@ -0,0 +1,31 @@
+import React from 'react';
+
+interface HeatMeterProps {
+  temperature: number;
+}
+
+const HEAT_FLOOR_C = 20;
+const HEAT_CEILING_C = 70;
+
+const getHeatClasses = (temperature: number) => {
+  if (temperature >= 60) return { bar: 'bg-accent-critical', text: 'text-accent-critical' };
+  if (temperature >= 50) return { bar: 'bg-accent-danger', text: 'text-accent-danger' };
+  if (temperature >= 40) return { bar: 'bg-accent-warning', text: 'text-accent-warning' };
+  return { bar: 'bg-text-primary/40', text: 'text-text-muted' };
+};
+
+const HeatMeter: React.FC<HeatMeterProps> = ({ temperature }) => {
+  const level = Math.min(1, Math.max(0, (temperature - HEAT_FLOOR_C) / (HEAT_CEILING_C - HEAT_FLOOR_C)));
+  const classes = getHeatClasses(temperature);
+
+  return (
+    <span className="flex items-center justify-end gap-2">
+      <span className="relative h-1 w-8 bg-text-primary/[0.08]" aria-hidden>
+        <span className={`absolute inset-y-0 left-0 transition-all duration-300 ${classes.bar}`} style={{ width: `${level * 100}%` }} />
+      </span>
+      <span className={`w-9 text-right tabular-nums ${classes.text}`}>{temperature}°C</span>
+    </span>
+  );
+};
+
+export default HeatMeter;
